; -- IKEMEN GO DOJO MODULE ------------------------------------------------
; ---- +system.def - default menu and pause menu extensions.
; ---- This file adds the module's modes to the main menu and provides the
; ---- text for their pause menus: [Trials Pause Menu] while a Trials match
; ---- is paused, [Tutorial Pause Menu] in the Game Tutorial and Character
; ---- Guides. The engine opens the section named after the game mode, so a
; ---- screenpack overrides either one by declaring it in its own system.def.
; --
; -- Module developed by two4teezee
; -------------------------------------------------------------------------

[Title Info]
; The Dojo: the module's modes, as one submenu at the end of the main menu. To place them elsewhere, copy
; these lines into your screenpack's system.def where you want them and comment them out here.
;   trials        - Trials: the select screen, then the character's trials (trials = trials.def)
;   tutorialgame  - Game Tutorial: a list of the game-wide lessons, each going straight into a match
;                   (config.ini's TutorialPlayerChar is P1; blank picks P1 on the select screen first)
;   tutorialchars - Character Guides: the select screen, with only characters that have their own
;                   lesson file left ungrayed, and only those lessons offered
; Each can also be listed on its own, at the top level or in another submenu. A fourth item,
; `tutorial`, offers the game-wide lessons and the character's own in a single list after the select
; screen. config.ini's [Modes] hides any of them.
menu.itemname.dojo = "Dojo"
menu.itemname.dojo.trials = "Trials"
menu.itemname.dojo.tutorialgame = "Game Tutorial"
menu.itemname.dojo.tutorialchars = "Character Guides"
menu.itemname.dojo.back = "Back"

[Select Info]
title.trials.text = "Trials Mode"
title.tutorial.text = "Tutorial Mode"

;--------------------------------------------------------------------------
; Pause menus. Both use the same itemnames and offer the same features; only the labels differ.
; Rows that would do nothing for the current trial or lesson are left out of the menu. Trials Mode's older itemnames
; (trialslist, trialsopts, trialadvancement, nexttrial, ...) are still accepted in a screenpack's own
; [Trials Pause Menu].
;
;   back                  Continue
;   tutorialinstructions  Show Instructions - the current trial's / lesson's pages again
;   tutorialdemo          Watch Demo - the CPU performs it (needs a demoscript)
;   tutorialrecord        Record Demo, tutorialrecorddummy Record Dummy - only with RecordDemo = true
;   tutorialrestart       Restart - back to the first step and the start positions
;   tutoriallist          the list of trials / lessons; picking one starts it
;   tutorialnext / tutorialprevious - the next / previous one
;   tutorialopts          an options submenu holding the rows below
;   tutorialspeedrun, tutorialadvancement, tutorialresetonsuccess, tutoriallayout,
;   tutorialtextboxes, tutorialhints, tutorialprogress (tutorialclearcharprogress, tutorialclearprogress)
;--------------------------------------------------------------------------

[Trials Pause Menu]
; Trials Pause option names and labels.
menu.valuename.tutorialadvancement_autoadvance = Auto-Advance
menu.valuename.tutorialadvancement_repeat = Repeat
menu.valuename.tutorialresetonsuccess_enabled = Yes
menu.valuename.tutorialresetonsuccess_disabled = No
menu.valuename.tutoriallayout_vertical = Vertical
menu.valuename.tutoriallayout_horizontal = Horizontal
menu.valuename.tutorialtextboxes_show = Show
menu.valuename.tutorialtextboxes_hide = Hide
menu.valuename.tutorialhints_show = Show
menu.valuename.tutorialhints_hide = Hide
menu.valuename.tutorialspeedrun_enabled = On
menu.valuename.tutorialspeedrun_disabled = Off
menu.valuename.tutorialclearprogress_ready =
menu.valuename.tutorialclearprogress_cleared = Cleared

; Trials List filter labels.
; The list is filtered by chapter when any trial declares trial.chapter, by difficulty otherwise.
; "All" is every trial; "Other" collects the ones that declare neither.
