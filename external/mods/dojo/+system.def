; -- IKEMEN GO DOJO MODULE ------------------------------------------------
; +system.def - default main menu and pause menu extensions.
; This file adds the module's modes to the main menu and provides the
; text for their pause menus.
; 
; -- Module developed by two4teezee
; -------------------------------------------------------------------------

[Title Info]
; The Dojo: the module's modes, as one submenu at the end of the main menu. To place them elsewhere, copy
; these lines into your screenpack's system.def where you want them and comment them out here.
;   trials          - Trials: the select screen, then the character's trials (trials = trials.def)
;   systemtutorial  - Game Tutorial: a list of the game-wide lessons, each going straight into a match
;                     (config.ini's TutorialPlayerChar is P1; blank picks P1 on the select screen first)
;   characterguides - Character Guides: the select screen, with only characters that have their own
;                     lesson file left ungrayed, and only those lessons offered
; Each can also be listed on its own, at the top level or in another submenu. A fourth item,
; `combinedtutorial`, offers the game-wide lessons and the character's own in a single list after the
; select screen. config.ini's [Modes] hides any of them. The standalone Tutorial Mode's itemnames
; (tutorialgame, tutorialchars, tutorial) are still accepted.
menu.itemname.dojo = "Dojo"
menu.itemname.dojo.trials = "Trials"
; menu.itemname.dojo.combinedtutorial = "Tutorial"
menu.itemname.dojo.systemtutorial = "Game Tutorial"
menu.itemname.dojo.characterguides = "Character Guides"
menu.itemname.dojo.back = "Back"

[Select Info]
; The select screen's title for each mode, keyed by its itemname. The tutorial modes fall back to
; title.tutorial.text when theirs is not set. (The Game Tutorial only shows the select
; screen when config.ini's TutorialPlayerChar is blank.)
title.trials.text = "Trials Mode"
; title.tutorial.text = "Tutorial Mode"
; title.combinedtutorial.text = "Tutorial"
title.systemtutorial.text = "Game Tutorial"
title.characterguides.text = "Character Guides"

;--------------------------------------------------------------------------
; Pause menus. Both offer the same features; each uses its own mode's itemnames and labels.
; Rows that would do nothing for the current trial or lesson are left out of the menu.
; [Trials Pause Menu] also accepts the tutorial* itemnames.
;
;   [Trials Pause Menu]      [Tutorial Pause Menu]
;   back                     back                     Continue
;   trialsinstructions       tutorialinstructions     Show Instructions - the current entry's pages again
;   trialsdemo               tutorialdemo             Watch Demo - the CPU performs it (needs a demoscript)
;   trialsrecord             tutorialrecord           Record Demo - only with RecordDemo = true
;   trialsrecorddummy        tutorialrecorddummy      Record Dummy - only with RecordDemo = true
;   trialsrestart            tutorialrestart          Restart - back to the first step and the start positions
;   trialslist               tutoriallist             the list of entries; picking one starts it
;   nexttrial / previoustrial  tutorialnext / tutorialprevious - the next / previous one
;   trialsopts               tutorialopts             an options submenu holding the rows below
;   trialsspeedrun           tutorialspeedrun         Speedrun Mode
;   trialadvancement         tutorialadvancement      Advancement
;   trialresetonsuccess      tutorialresetonsuccess   Reset on Success
;   trialslayout             tutoriallayout           Layout
;   trialstextboxes          tutorialtextboxes        Textboxes
;   trialshints              tutorialhints            Hints
;   trialsprogress           tutorialprogress         Clear Progress, holding:
;   trialsclearcharprogress  tutorialclearcharprogress  this character's records
;   trialsclearprogress      tutorialclearprogress    everything in the mode's save file
; Filter labels: menu.valuename.trialsdifficulty_* / trialschapter_* and tutorialdifficulty_* / tutorialchapter_*.
;--------------------------------------------------------------------------

[Trials Pause Menu]

menu.valuename.trialadvancement_autoadvance = Auto-Advance
menu.valuename.trialadvancement_repeat = Repeat
menu.valuename.trialresetonsuccess_enabled = Yes
