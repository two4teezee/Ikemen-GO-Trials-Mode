# -- IKEMEN GO DOJO MODULE ------------------------------------------------
# dojo.zss - global states and functions for the Ikemen GO Dojo Module
# 
# -- Module developed by two4teezee
# -------------------------------------------------------------------------

# maps set via Pause Menu (menu.lua)
# _iksys_dojoDummyControl: 0 - cooperative, 1 - ai, 2 - manual
# _iksys_dojoGuardMode: 0 - none, 1 - afterhit (guards for 15 frames after being hit), 2 - all (lesson.guardmode = auto), 3 - random
# _iksys_dojoFallRecovery: 0 - none, 1 - ground, 2 - air, 3 - random
# _iksys_dojoDummyMode: 0 - stand, 1 - crouch, 2 - jump, 3 - wjump, 4 - fjump, 5 - bjump, 6 - fwjump, 7 - bwjump
# _iksys_dojoDistance: 0 - any, 1 - close, 2 - medium, 3 - far (set from lesson.dummypos)
# _iksys_dojoInPlace: 1 while the dummy is keeping a distance and sits inside its band (read by Lua to hold a looping dummyscript)
# _iksys_dojoButtonJam: 0 - none, 1-9 - a/b/c/x/y/z/s/d/w
# _iksys_dojoButtonJamInterval: frames to wait between button jam presses (lesson.dummybuttondelay)
# _iksys_dojoAirJamState / _iksys_dojoAirJamTimer: the jump modes' once-per-jump button jam (see Button jam)
# _iksys_dojoJumpInterval: frames to stay on the ground between jumps in the jump dummy modes (lesson.dummyjumpdelay)
# _iksys_dojoSetLife: life the refill restores (lesson.dummylife / lesson.playerlife), else lifeMax
# _iksys_dojoReposition / _iksys_dojoCameraReset: one-shot requests from Lua, cleared here once served
# _iksys_dojoCameraPosX, _iksys_dojoPlayerPosX/Y, _iksys_dojoDummyPosX/Y: where a reposition puts the camera and both sides
# _iksys_dojoButtonJamDelay: frames before the next button jam press, re-armed by Lua after a reset fade
# _iksys_dojoMenuOpen: countdown re-seeded by Lua while the Lesson select view is up; > 0 holds both sides
# _iksys_dojoMenuHeld: 1 while this side is being held, so control is handed back once on release
# _iksys_dojoScript: 1 while an input script drives this side; _iksys_dojoIn<Up|Down|Fwd|Back|a|b|c|x|y|z|s|d|w>: 1 for each input held this frame (map names are case-insensitive, so the directions are spelled out to stay clear of the b and d buttons)

#===============================================================================
# Functions
#===============================================================================
[Function DojoReposition()]
if map(_iksys_dojoReposition) != 0 {
	Camera{
		view: free; 
		pos: map(_iksys_dojoCameraPosX), (map(_iksys_dojoPlayerPosY) + map(_iksys_dojoDummyPosY))/2;
	}
	PosSet{
		x: map(_iksys_dojoPlayerPosX); 
		y: map(_iksys_dojoPlayerPosY); 
		redirectID: player(1),id;
	}
	PosSet{
		x: map(_iksys_dojoDummyPosX);
		y: map(_iksys_dojoDummyPosY);
		redirectID: player(2),id;
	}
}

[Function DojoButtonJamPress()]
# One frame of the button set by _iksys_dojoButtonJam, on the root and every helper.
switch map(_iksys_dojoButtonJam) {
case 1:
	for i = 0; numHelper; 1 {
		assertInput{flag: a; redirectID: helperIndex($i), ID}
	}
case 2:
	for i = 0; numHelper; 1 {
		assertInput{flag: b; redirectID: helperIndex($i), ID}
	}
case 3:
	for i = 0; numHelper; 1 {
		assertInput{flag: c; redirectID: helperIndex($i), ID}
	}
case 4:
	for i = 0; numHelper; 1 {
		assertInput{flag: x; redirectID: helperIndex($i), ID}
	}
case 5:
	for i = 0; numHelper; 1 {
		assertInput{flag: y; redirectID: helperIndex($i), ID}
	}
case 6:
	for i = 0; numHelper; 1 {
		assertInput{flag: z; redirectID: helperIndex($i), ID}
	}
case 7:
	for i = 0; numHelper; 1 {
		assertInput{flag: s; redirectID: helperIndex($i), ID}
	}
case 8:
	for i = 0; numHelper; 1 {
		assertInput{flag: d; redirectID: helperIndex($i), ID}
	}
case 9:
	for i = 0; numHelper; 1 {
		assertInput{flag: w; redirectID: helperIndex($i), ID}
	}
default:
	# Nothing to press
}

[Function DojoScriptPress()]
# One frame of an input script - lesson.demoscript on P1, lesson.dummyscript on P2 - on the root and
# every helper. Lua sets one map per input every frame the script runs (dojo.f_scriptTick).
# F and B are relative to facing, as in a command.
for i = 0; numHelper; 1 {
	if map(_iksys_dojoInUp) {
		assertInput{flag: U; redirectID: helperIndex($i), ID}
	}
	if map(_iksys_dojoInDown) {
		assertInput{flag: D; redirectID: helperIndex($i), ID}
	}
	if map(_iksys_dojoInFwd) {
		assertInput{flag: F; redirectID: helperIndex($i), ID}
	}
	if map(_iksys_dojoInBack) {
		assertInput{flag: B; redirectID: helperIndex($i), ID}
	}
	if map(_iksys_dojoIna) {
		assertInput{flag: a; redirectID: helperIndex($i), ID}
	}
	if map(_iksys_dojoInb) {
		assertInput{flag: b; redirectID: helperIndex($i), ID}
	}
	if map(_iksys_dojoInc) {
		assertInput{flag: c; redirectID: helperIndex($i), ID}
	}
	if map(_iksys_dojoInx) {
		assertInput{flag: x; redirectID: helperIndex($i), ID}
	}
	if map(_iksys_dojoIny) {
		assertInput{flag: y; redirectID: helperIndex($i), ID}
	}
	if map(_iksys_dojoInz) {
		assertInput{flag: z; redirectID: helperIndex($i), ID}
	}
	if map(_iksys_dojoIns) {
		assertInput{flag: s; redirectID: helperIndex($i), ID}
	}
	if map(_iksys_dojoInd) {
		assertInput{flag: d; redirectID: helperIndex($i), ID}
	}
	if map(_iksys_dojoInw) {
		assertInput{flag: w; redirectID: helperIndex($i), ID}
	}
}

[Function DojoResetCamera()]
Camera{view: fighting}

#===============================================================================
# Global states (not halted by Pause/SuperPause, no helper limitations)
#===============================================================================
[StateDef -4]

# Trials plays as gameMode "trials", the Game Tutorial and Character Guides as "tutorial".
ignoreHitPause if gameMode = "trials" || gameMode = "tutorial" {
	# Round start reset
	if roundState = 0 {
		powerSet{value: powerMax}
		map(_iksys_dojoLifeTimer) := 0;
		map(_iksys_dojoPowerTimer) := 0;
		map(_iksys_dojoReposition) := 0;
		map(_iksys_dojoMenuOpen) := 0;
		map(_iksys_dojoMenuHeld) := 0;
		map(_iksys_dojoScript) := 0;
	}
	# Input scripts (demonstrations and dummy scripts), pressed for whichever side Lua is driving.
	if !isHelper && roundState = 2 && map(_iksys_dojoScript) != 0 {
		call DojoScriptPress();
	}
	# Hold both sides still while the Lesson select view is up, so the buttons that drive the
	# menu don't also drive the character. Lua re-seeds the counter every frame the view is up
	# (dojo.f_menuHold), so the hold lets go on its own if the view ever stops driving it.
	# ctrlSet is not self-clearing: nothing in a character's own standing state restores ctrl, so
	# the release branch has to hand control back, exactly once, whichever way the hold ended.
	if !isHelper {
		if map(_iksys_dojoMenuOpen) > 0 {
			map(_iksys_dojoMenuOpen) := map(_iksys_dojoMenuOpen) - 1;
			if roundState = 2 {
				map(_iksys_dojoMenuHeld) := 1;
				ctrlSet{value: 0}
			}
		} else if map(_iksys_dojoMenuHeld) != 0 {
			map(_iksys_dojoMenuHeld) := 0;
			ctrlSet{value: 1}
		}
	}
	# Life and Power recovery
	if !isHelper {
		# Life
		if moveType = H || dizzy {
			mapSet{map: "_iksys_dojoLifeTimer"; value: 0}
		} else {
			mapAdd{map: "_iksys_dojoLifeTimer"; value: 1}
		}
		if map(_iksys_dojoLifeTimer) >= 60 {
			if map(_iksys_dojoSetLife) > 0 {
				lifeSet{value: map(_iksys_dojoSetLife)}
				redLifeSet{value: map(_iksys_dojoSetLife)}
			} else {
				lifeSet{value: lifeMax}
				redLifeSet{value: lifeMax}
			}
			mapSet{map: "_iksys_dojoLifeTimer"; value: 0}
		}
		# Power
		if ctrl = 0 {
			mapSet{map: "_iksys_dojoPowerTimer"; value: 0}
		} else {
			mapAdd{map: "_iksys_dojoPowerTimer"; value: 1}
		}
		if map(_iksys_dojoPowerTimer) >= 60 {
			powerSet{value: powerMax}
			mapSet{map: "_iksys_dojoPowerTimer"; value: 0}
		}
	}
	# Disable normal KO behavior
	assertSpecial{
		flag: globalNoKo;
		flag2: noKoFall;
		flag3: noKoVelocity;
	}
	# Force players out of KO state
	if stateNo = 5150 && time >= 90 && alive {
		selfState{value: 5120}
	}
	# Skip round and fight calls
	if roundState < 2 {
		assertSpecial{flag: skipRoundDisplay; flag2: skipFightDisplay}
	}
	# Dummy code
	if teamSide = 2 && !isHelper {
		if roundState = 0 {
			# Round start reset
			map(_iksys_dojoButtonJam) := 0;
			map(_iksys_dojoDirection) := 0;
			map(_iksys_dojoDistance) := 0;
			map(_iksys_dojoInPlace) := 0;
			map(_iksys_dojoDummyControl) := 0;
			map(_iksys_dojoDummyMode) := 0;
			map(_iksys_dojoJumpDelay) := 0;
			map(_iksys_dojoAirJamState) := 0;
			map(_iksys_dojoFallRecovery) := 0;
			map(_iksys_dojoGuardMode) := 0;
		}
		if roundState = 2 {
			# Dummy Control: Cooperative
			if aiLevel = 0 && map(_iksys_dojoDummyControl) = 0 {
				# Guard mode: Random
				if map(_iksys_dojoGuardMode) = 3 {
					if random < 500 {
						assertSpecial{flag: autoGuard}
					}
				# Guard mode: All
				} else if map(_iksys_dojoGuardMode) = 2 {
					assertSpecial{flag: autoGuard}
				# Guard mode: Auto
				} else if map(_iksys_dojoGuardMode) = 1 {
					if moveType = H || stateNo = const(StateDownedGetHit_gettingUp) {
						map(_iksys_dojoAutoGuardTimer) := 15;
					} else {
						map(_iksys_dojoAutoGuardTimer) := (map(_iksys_dojoAutoGuardTimer) - 1);
					}
					if map(_iksys_dojoAutoGuardTimer) > 0 {
						assertSpecial{flag: autoGuard}
					}
				}
				# Fall Recovery
				if map(_iksys_dojoFallRecovery) {
					if stateNo != [const(StateAirGetHit_fallRecoveryOnGroundStillFalling), const(StateAirGetHit_fallRecoveryInAir)] {
						if moveType = H && stateType = A && hitFall && !getHitVar(isbound) && (pos y || vel y) {
							# Ground recovery. Attempt only if common1 conditions are met
							if vel y > 0 && pos y >= const(movement.air.gethit.groundrecover.ground.threshold) {
								if map(_iksys_dojoFallRecovery) = 1 { 
									let rcv = 1;
								}
							# Air recovery. Attempt only if conditions for ground recovery are not met
							} else if map(_iksys_dojoFallRecovery) = 2 {
								let rcv = 1;
							}
							# Random recovery. Attempt regardless of conditions
							if map(_iksys_dojoFallRecovery) = 3 && random < 100 {
								let rcv = 1;
							}
							if $rcv {
								# WinMugen characters assert inputs because asserting commands directly may trigger their AI activation codes
								if mugenVersion(major) = 0 {
									if gametime % 2 {
										assertInput{flag: x; flag2: y; flag3: z}
									} else {
										assertInput{flag: a; flag2: b; flag3: c}
									}
								} else {
									assertCommand{name: "recovery"; buffer.time: 2}
									# Buffered 2 frames because asserting a command instead of inputting it has 1 frame of lag in custom fall recovery systems
								}
								# Random direction
								if map(_iksys_dojoFallRecovery) = 3 {
									if random < 333 {
										assertInput{flag: L}
									} else if random < 500 {
										assertInput{flag: R}
									}
									if random < 333 {
										assertInput{flag: U}
									} else if random < 500 {
										assertInput{flag: D}
									}
								}
							}
						}
					}
				}
				# Distance
				# Only judged on the ground with control, so a jump in progress lands where it lands
				# and the dummy walks back into place afterwards. Dropping control (getting hit,
				# landing) or leaving the ground ends any walk, so the dummy mode and button jam take over.
				let dir = 0;
				if !ctrl || stateType = A {
					map(_iksys_dojoDirection) := 0;
				}
				if map(_iksys_dojoDistance) != 0 && ctrl && stateType != A {
					# Close
					if map(_iksys_dojoDistance) = 1 {
						if p2BodyDist x > const240p(10) {
							let dir = 1;
							map(_iksys_dojoDirection) := 1;
						} else if p2BodyDist x < -(const(size.ground.front) + const(size.ground.back) + const240p(10)) {
							let dir = -1;
							map(_iksys_dojoDirection) := -1;
						}
					# Medium
					} else if map(_iksys_dojoDistance) = 2 {
						if p2BodyDist x > const240p(130) {
							let dir = 1;
							map(_iksys_dojoDirection) := 1;
						} else if p2BodyDist x < const240p(80) && backEdgeBodyDist > const240p(10) {
							let dir = -1;
							map(_iksys_dojoDirection) := -1;
						}
					# Far
					# Bounds bracket where lesson.dummypos = far puts the pair, as close and medium do.
					} else if map(_iksys_dojoDistance) = 3 {
						if p2BodyDist x > const240p(260) {
							let dir = 1;
							map(_iksys_dojoDirection) := 1;
						} else if p2BodyDist x < const240p(200) && backEdgeBodyDist > const240p(10) {
							let dir = -1;
							map(_iksys_dojoDirection) := -1;
						}
					}
				}
				# In place: keeping a distance, on the ground with control, inside its band and not walking.
				# A looping dummyscript waits on this before each pass (dojo.f_scriptTick).
				# Parenthesised: := binds tighter than &&, so without them only the first term would be stored.
				map(_iksys_dojoInPlace) := (map(_iksys_dojoDistance) != 0 && ctrl && stateType != A && $dir = 0 && map(_iksys_dojoDirection) = 0);
				if map(_iksys_dojoDirection) != 0 {
					# If adjusting position is no longer needed
					if $dir = 0 {
						# maintain assertion only if dummy and nearest P1 are moving in the same direction
						if vel x * p2,vel x >= 0 || backEdgeBodyDist = 0 || p2,backEdgeBodyDist = 0 {
							map(_iksys_dojoDirection) := 0;
						}
					}
					# If dummy should move forward and player is not trying to move dummy manually
					if map(_iksys_dojoDirection) = 1 {
						if inputTime(B) < 0 && inputTime(D) < 0 && inputTime(U) < 0 {
							for i = 0; numHelper; 1 {
								assertInput{flag: F; redirectID: helperIndex($i), ID} # Index 0 being the root
							}
						}
					# If dummy should move backward and player is not trying to move dummy manually
					} else if map(_iksys_dojoDirection) = -1 {
						# Back is also guard: never walk back inside guard distance, so the dummy can't block by it.
						if inputTime(F) < 0 && inputTime(D) < 0 && inputTime(U) < 0 && !inGuardDist {
							for i = 0; numHelper; 1 {
								assertInput{flag: B; redirectID: helperIndex($i), ID}
							}
						}
					}
				} else {
					# Jump delay: rearmed while airborne, counted down once back on the ground. The jump modes
					# only press anything on the ground once it runs out, so the dummy waits after landing.
					if stateType = A {
						map(_iksys_dojoJumpDelay) := map(_iksys_dojoJumpInterval);
					} else {
						if map(_iksys_dojoJumpDelay) > 0 {
							mapAdd{map: "_iksys_dojoJumpDelay"; value: -1}
						}
					}
					# Dummy mode
					switch map(_iksys_dojoDummyMode) {
					# Crouch
					case 1:
						if inputTime(L) < 0 && inputTime(R) < 0 && inputTime(U) < 0 {
							for i = 0; numHelper; 1 {
								assertInput{flag: D; redirectID: helperIndex($i), ID}
							}
						}
					# Jump modes: up is only pressed on the ground once the dummy has control. Held through the
					# landing it would jump on the first frame control came back, before the dummy could ever
					# walk back to its lesson.dummypos distance. F and B are still held without control: the
					# pre-jump frames are where the jump picks its direction.
					# Jump
					case 2:
						if inputTime(L) < 0 && inputTime(R) < 0 && inputTime(D) < 0 && (stateType = A || map(_iksys_dojoJumpDelay) <= 0) {
							for i = 0; numHelper; 1 {
								if stateType = A || ctrl {
									assertInput{flag: U; redirectID: helperIndex($i), ID}
								}
							}
						}
					# W Jump
					case 3:
						if inputTime(L) < 0 && inputTime(R) < 0 && inputTime(D) < 0 {
							if vel y >= 0 && (stateType = A || map(_iksys_dojoJumpDelay) <= 0) {
								for i = 0; numHelper; 1 {
									if stateType = A || ctrl {
										assertInput{flag: U; redirectID: helperIndex($i), ID}
									}
								}
							}
						}
					# Forward Jump
					case 4:
						if inputTime(L) < 0 && inputTime(R) < 0 && inputTime(D) < 0 && (stateType = A || map(_iksys_dojoJumpDelay) <= 0) {
							for i = 0; numHelper; 1 {
								if stateType = A || ctrl {
									assertInput{flag: U; redirectID: helperIndex($i), ID}
								}
								assertInput{flag: F; redirectID: helperIndex($i), ID}
							}
						}
					# Back Jump
					case 5:
						if inputTime(L) < 0 && inputTime(R) < 0 && inputTime(D) < 0 && (stateType = A || map(_iksys_dojoJumpDelay) <= 0) {
							for i = 0; numHelper; 1 {
								if stateType = A || ctrl {
									assertInput{flag: U; redirectID: helperIndex($i), ID}
								}
							}
							# Back is also guard: only held outside guard distance, so the dummy never blocks by it.
							if !inGuardDist {
								for i = 0; numHelper; 1 {
									assertInput{flag: B; redirectID: helperIndex($i), ID}
								}
							}
						}
					# Forward W Jump
					case 6:
						if inputTime(L) < 0 && inputTime(R) < 0 && inputTime(D) < 0 {
							if vel y >= 0 && (stateType = A || map(_iksys_dojoJumpDelay) <= 0) {
								for i = 0; numHelper; 1 {
									if stateType = A || ctrl {
										assertInput{flag: U; redirectID: helperIndex($i), ID}
									}
									assertInput{flag: F; redirectID: helperIndex($i), ID}
								}
							}
						}
					# Back W Jump
					case 7:
						if inputTime(L) < 0 && inputTime(R) < 0 && inputTime(D) < 0 {
							if vel y >= 0 && (stateType = A || map(_iksys_dojoJumpDelay) <= 0) {
								for i = 0; numHelper; 1 {
									if stateType = A || ctrl {
										assertInput{flag: U; redirectID: helperIndex($i), ID}
									}
								}
								# Back is also guard: only held outside guard distance, so the dummy never blocks by it.
								if !inGuardDist {
									for i = 0; numHelper; 1 {
										assertInput{flag: B; redirectID: helperIndex($i), ID}
									}
								}
							}
						}
					default:
						# Do nothing
					}
					# Button jam
					if map(_iksys_dojoButtonJam) > 0 {
						if map(_iksys_dojoDummyMode) >= 2 {
							# Jump modes: a button pressed on the ground starts a ground attack instead of the
							# jump, so the button is only ever pressed in the air - once per trip off the ground,
							# _iksys_dojoButtonJamInterval frames after takeoff (a jump attack). The w modes'
							# air jump does not rearm it. 0 - waiting to take off, 1 - counting, 2 - spent.
							if stateType = A {
								if moveType = H {
									# Knocked into the air is not a jump: nothing to attack with until it lands.
									map(_iksys_dojoAirJamState) := 2;
								} else if map(_iksys_dojoAirJamState) = 0 {
									map(_iksys_dojoAirJamState) := 1;
									map(_iksys_dojoAirJamTimer) := map(_iksys_dojoButtonJamInterval);
								}
								if map(_iksys_dojoAirJamState) = 1 {
									if map(_iksys_dojoAirJamTimer) > 0 {
										mapAdd{map: "_iksys_dojoAirJamTimer"; value: -1}
									} else {
										map(_iksys_dojoAirJamState) := 2;
										call DojoButtonJamPress();
									}
								}
							} else {
								map(_iksys_dojoAirJamState) := 0;
							}
						} else {
							# Other modes: press every _iksys_dojoButtonJamInterval frames.
							if map(_iksys_dojoButtonJamDelay) > 0 {
								mapAdd{map: "_iksys_dojoButtonJamDelay"; value: -1}
							} else {
								map(_iksys_dojoButtonJamDelay) := map(_iksys_dojoButtonJamInterval);
								call DojoButtonJamPress();
							}
						}
					}
				}
				if map(_iksys_dojoReposition) != 0 {
					call DojoReposition();
					map(_iksys_dojoReposition) := 0;
				}
				if map(_iksys_dojoCameraReset) != 0 {
					call DojoResetCamera();
					map(_iksys_dojoCameraReset) := 0;
				}
			}
		}
	}
}
