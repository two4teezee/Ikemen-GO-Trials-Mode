title.vertical.bg.scale = 1.0, 1.0
title.vertical.bg.facing = 1
title.vertical.bg.displaytime = -1
title.vertical.bg.layerno = 0
title.vertical.front.offset = 0, 0
title.vertical.front.spr = 
title.vertical.front.anim = -1
title.vertical.front.scale = 1.0, 1.0
title.vertical.front.facing = 1
title.vertical.front.displaytime = -1
title.vertical.front.layerno = 0
; TRIALTITLE HORIZONTAL ----------------------------------------------------
title.horizontal.anchor = left
title.horizontal.pos = 140,190
title.horizontal.text.offset = 0,-25
title.horizontal.text.font = 1,0,1, 255, 200, 100
title.horizontal.text.scale = 2,2
title.horizontal.text.font.height = -1
title.horizontal.bg.offset = 0, 0
title.horizontal.bg.spr = 
