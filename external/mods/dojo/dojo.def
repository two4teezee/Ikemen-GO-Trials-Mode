allclear.front.layerno = 0

; TEACHING ELEMENTS --------------------------------------------------------
; Used by any trial or lesson whose file asks for them: instruction pages (trial.page.N.*), a hint
; (trial.hint), a demo (trial.demoscript) or repetitions (trial.repeat). A file without any of
; these never shows them.
; --------------------------------------------------------------------------

; INSTRUCTION PAGES --------------------------------------------------------
; A trial's trial.page.N.title / trial.page.N.text, shown when the trial is entered and again
; from the pause menu's Show Instructions. Play is held while they are up. The menu's done key turns
; the page (or finishes the typing), its cancel key goes back one.
; instructions.pos is the block's centre; everything else is offset from it.
; instructions.title.text: %s is the page title (the trial name when the page has none), %n the
;   trial name.
; instructions.text.window: x1,y1,x2,y2 from pos; the body wraps inside it. Write \n in a page's
;   text for a line break.
; instructions.text.drawspeed: frames per character as the text types out; 0 shows it at once.
; instructions.page.text: %s is this page, %t the page count. Not drawn for a single page.
; instructions.snd: played when the pages open (dojo.snd if shipped, else system.snd).
; instructions.page.snd: played each time a page is shown, the first one included, from the same
;   place. A page can play its own instead with trial.page.N.snd.
; instructions.portrait.<options>: a portrait drawn with the pages, the way textbox.portrait is drawn
;   with the textbox. spr or anim, offset from pos, scale, facing, layerno. A page can show its own
;   with trial.page.N.portrait.spr / .anim / .source, which replace the spr and anim given here.
;   source: "system" takes spr and anim from the module's own sprites and actions (see WHERE SPRITES
;     AND SOUNDS COME FROM); "char" takes them from P1's own sff and air.
;   window: x1,y1,x2,y2 from the portrait's position to clip it to; all zero leaves it unclipped.
;   Leave spr blank and anim at -1 for no portrait unless a page asks for one.
; --------------------------------------------------------------------------
instructions.pos = 640,360
instructions.snd = -1,0
instructions.overlay.visible = true
instructions.overlay.window = -640,-360, 640,360
instructions.overlay.col = 0, 0, 0
instructions.overlay.alpha = 0, 160
instructions.overlay.layerno = 2
instructions.bg.offset = 0,0
instructions.bg.spr =
instructions.bg.anim = -1
instructions.bg.scale = 1.0, 1.0
instructions.bg.layerno = 2
instructions.title.offset = 0,-150
instructions.title.font = 4,0,0, 255, 220, 120
instructions.title.scale = 2,2
instructions.title.font.height = -1
instructions.title.text = "%s"
instructions.title.layerno = 2
instructions.text.offset = -380,-100
instructions.text.window = -390,-110, 390,130
instructions.text.font = 1,0,1
instructions.text.scale = 2,2
instructions.text.font.height = -1
instructions.text.drawspeed = 1
instructions.text.layerno = 2
instructions.page.offset = 380,170
instructions.page.font = 1,0,-1, 190, 190, 190
instructions.page.scale = 2,2
instructions.page.font.height = -1
instructions.page.text = "%s/%t"
instructions.page.layerno = 2
instructions.page.snd = -1,0
instructions.portrait.source = "char" ; valid options are "system" or "char"
instructions.portrait.spr = 9000,1
instructions.portrait.anim = -1
instructions.portrait.offset = -620,-110
instructions.portrait.window = 0,0, 0,0
instructions.portrait.facing = 1
instructions.portrait.scale = 1.5,1.5
instructions.portrait.layerno = 2
instructions.prompt.offset = 0,170
instructions.prompt.font = 1,0,0, 255, 255, 255
instructions.prompt.scale = 2,2
instructions.prompt.font.height = -1
instructions.prompt.text = "Press to continue"
instructions.prompt.layerno = 2
instructions.front.offset = 0,0
instructions.front.spr =
instructions.front.anim = -1
instructions.front.layerno = 2

; HINT ---------------------------------------------------------------------
; A trial's trial.hint, shown once the player has failed it trial.hintafter times (from the
; start when hintafter is 0), while the Hints option is on. A failure is an attempt that got
; partway and was dropped, or - in a blocking trial - being hit instead of blocking.
; hint.text.text: %s is the hint. hint.text.window: x1,y1,x2,y2 from pos to wrap in; all zero
;   leaves it on one line.
; --------------------------------------------------------------------------
hint.visible = true
hint.pos = 640,640
hint.text.offset = 0,0
hint.text.font = 1,0,0, 255, 230, 140
hint.text.scale = 2,2
hint.text.font.height = -1
hint.text.text = "Hint: %s"
hint.text.window = 0,0, 0,0
hint.bg.offset = 0,0
hint.bg.spr =
hint.bg.anim = -1
hint.bg.layerno = 0

; DEMONSTRATION -------------------------------------------------------------
; demo.*: shown while the CPU plays a trial's trial.demoscript (pause menu: Watch Demo). The player's
;   controller is switched off for it; the menu's done or cancel key ends it early.
; demoprompt.*: shown once the player has failed a trial trial.demoafter times, pointing them
;   at Watch Demo. Set demoprompt.text.text to "" to leave it out.
; --------------------------------------------------------------------------
demo.pos = 640,90
demo.text.offset = 0,0
demo.text.font = 4,0,0, 120, 200, 255
demo.text.scale = 2,2
demo.text.font.height = -1
demo.text.text = "DEMO"
demo.bg.offset = 0,0
demo.bg.spr =
demo.bg.anim = -1
demo.bg.layerno = 0
demoprompt.pos = 640,600
demoprompt.text.offset = 0,0
demoprompt.text.font = 1,0,0, 120, 200, 255
demoprompt.text.scale = 2,2
demoprompt.text.font.height = -1
demoprompt.text.text = "Stuck? Pause and pick Watch Demo."

; REPETITION COUNTER -------------------------------------------------------
; Drawn for trials with trial.repeat above 1. %s is the clears made, %t the clears needed.
; repcounter.snd plays on each clear short of the last (the last gets the success banner).
; --------------------------------------------------------------------------
repcounter.pos = 640,120
repcounter.snd = -1,0
repcounter.text.offset = 0,0
repcounter.text.font = 4,0,0, 255, 255, 255
repcounter.text.scale = 2,2
repcounter.text.font.height = -1
repcounter.text.text = "%s / %t"
repcounter.bg.offset = 0,0
repcounter.bg.spr =
repcounter.bg.anim = -1
repcounter.bg.layerno = 0


; TRIAL SELECT MENU --------------------------------------------------------
; The menu of the character's trials, shown when the match loads and again whenever the player
; picks "Trials List" from the pause menu. It is drawn by the module, so everything about it is
; configured here rather than in the screenpack's [Trials Pause Menu] section.
;
; Rows are laid out from menu.pos, menu.spacing apart, menu.visibleitems at a
; time. A row is one of three kinds, each with its own text and background:
;   header - the difficulty filter, shown only when the character has more than one to cycle
;   item   - a trial. Uses .active when the cursor is on it, .selected for the trial in play
;   (the section's own tail items, "Back" among them, are drawn as plain items)
;
; Every bg/front/cursor/status element takes the usual spr, anim, offset, scale, facing,
; displaytime and layerno parameters. Leave spr empty and anim at -1 to draw nothing.
; --------------------------------------------------------------------------
; menu.layerno is the layer every element in this block sits on unless it names its own.
; The menu covers a live match, so it defaults to 2 rather than sharing layer 0 with the HUD.
menu.layerno = 2
; The rows are a centred block, so the whole menu travels as one with the middle of the screen.
menu.anchor = center
menu.pos = 320,240
menu.spacing = 0,26
menu.visibleitems = 9
; menu.window clips every row's text to this rectangle. Leave unset for no clipping.
menu.window = 

menu.bg.offset = 0,-40
menu.bg.spr = 
menu.bg.anim = -1
menu.bg.scale = 1.0, 1.0
menu.bg.facing = 1
menu.bg.displaytime = -1
menu.bg.layerno = 0

menu.front.offset = 0,-40
menu.front.spr = 
menu.front.anim = -1
menu.front.scale = 1.0, 1.0
menu.front.facing = 1
menu.front.displaytime = -1
menu.front.layerno = 0

; menu.overlay dims whatever is behind the menu. Set visible to false to leave the match visible.
; alpha is source,destination, the same as every other overlay in the engine: 0,128 halves what is
; behind it. Raising the first number adds col to the picture rather than dimming it.
menu.overlay.visible = true
menu.overlay.window = 0,0,1280,720
menu.overlay.col = 0,0,0
menu.overlay.alpha = 0,64
menu.overlay.layerno = 0

; TITLE --------------------------------------------------------------------
menu.title.offset = 320,-52
menu.title.font = 1,0,0, 255, 255, 255
menu.title.scale = 2,2
menu.title.font.height = -1

; FILTER HEADER ------------------------------------------------------------
; The difficulty filter the player cycles with left and right, and how many of it are cleared.
; It is pinned: menu.header.offset places it relative to menu.pos and it stays there
; while the rows scroll underneath. The text and value offsets are relative to the banner.
;
; menu.headerdisplay picks the shape:
;   default    - one banner, naming the filter on show. Arrows mark that there are others.
;   sidebyside - every filter laid out at menu.header.spacing apart, the one on show
;                wearing the menu.header.active elements below.
;
; menu.header.active.* styles the filter on show. It inherits from the plain header
; elements, so leaving it out means both look the same - which is what "default" has always
; done, and what makes side by side need a highlight of its own before it reads.
;
; menu.header.value.text formats the tally; "" leaves it off, which side by side often
; wants once six of them are on one line.
menu.headerdisplay = default
menu.header.offset = 0, -26
menu.header.spacing = 150,0
menu.header.text.offset = 0,0
menu.header.text.font = 1,0,1, 255, 220, 120
menu.header.text.scale = 2,2
menu.header.text.font.height = -1

menu.header.value.offset = 640,0
menu.header.value.font = 1,0,-1, 255, 220, 120
menu.header.value.scale = 2,2
menu.header.value.font.height = -1
menu.header.value.text = "%s"

; The filter on show. Declare only what should differ from the elements above.
menu.header.active.text.font = 1,0,1, 255, 255, 255
menu.header.active.value.font = 1,0,-1, 255, 255, 255
menu.header.bg.offset = 0,0
menu.header.bg.spr = 
menu.header.bg.anim = -1
menu.header.bg.scale = 1.0, 1.0
menu.header.bg.facing = 1
menu.header.bg.displaytime = -1
menu.header.bg.layerno = 0

; ROWS ---------------------------------------------------------------------
menu.item.text.offset = 0,0
menu.item.text.font = 1,0,1, 190, 190, 190
menu.item.text.scale = 2,2
menu.item.text.font.height = -1
menu.item.locked.text.font = 1,0,1, 110, 110, 110

; menu.item.active.overlay is a rect drawn under the row the cursor is on, the highlight bar
; that follows it down the list. It works like menu.overlay, except its window is x1,y1,x2,y2
; taken from that row's origin rather than from the screen, so it travels with the cursor: y1 is how
; far above the row's baseline the bar starts, y2 how far below it ends. Give the window no area, or
; set visible to false, to leave the bar off and highlight the row by text colour alone.
menu.item.active.overlay.visible = true
menu.item.active.overlay.window = -12,-15, 652,10
menu.item.active.overlay.col = 255,255,255
menu.item.active.overlay.alpha = 48,255
menu.item.active.overlay.layerno = 2
; .selected is the trial currently in play, whether or not the cursor is on it.
menu.item.selected.text.offset = 0,0
menu.item.selected.text.font = 1,0,1, 120, 255, 160
menu.item.selected.text.scale = 2,2
menu.item.selected.text.font.height = -1

menu.item.bg.offset = 0,0
menu.item.bg.spr = 
menu.item.bg.anim = -1
menu.item.bg.scale = 1.0, 1.0
menu.item.bg.facing = 1
menu.item.bg.displaytime = -1
menu.item.bg.layerno = 0

; .active is the row the cursor is on.
menu.item.active.text.offset = 0,0
menu.item.active.text.font = 1,0,1, 255, 255, 255
menu.item.active.text.scale = 2,2
menu.item.active.text.font.height = -1
menu.item.active.bg.offset = 0,0
menu.item.active.bg.spr = 
menu.item.active.bg.anim = -1
menu.item.active.bg.scale = 1.0, 1.0
menu.item.active.bg.facing = 1
menu.item.active.bg.displaytime = -1
menu.item.active.bg.layerno = 0

; PER-CATEGORY OVERRIDES ---------------------------------------------------
; Any of the row and banner elements above can be respecified for one difficulty category, by
; putting the category name straight after "item" or "header":
;
;   menu.item.<category>.text.*            a trial of that difficulty, at rest
;   menu.item.<category>.active.text.*     ...under the cursor
;   menu.item.<category>.selected.text.*   ...when it is the trial in play
;   menu.item.<category>.bg.*              its row background
;   menu.item.<category>.active.bg.*       ...under the cursor
;   menu.item.<category>.active.overlay.*  its highlight bar, under the cursor
;   menu.header.<category>.text.*          the banner, while that filter is showing
;   menu.header.<category>.value.*         its cleared tally
;   menu.header.<category>.bg.*            its background
;
; Categories for a row are beginner, intermediate, advanced, expert and other ("other" being the
; trials whose def declares no trial.difficulty). The banner adds "all", the unfiltered view.
;
; Declare only what differs: anything a category leaves out is inherited from the shared element
; it overrides, so a colour change is one line. A category with no block at all is drawn exactly
; as before. Offsets are relative to the row, so a category can sit somewhere else on the line.
;
; For example, to make Expert trials red, shift them right, and give the Expert banner its own
; sprite, without touching anything else:
;
;   menu.item.expert.text.font = 1,0,1, 255, 90, 90
;   menu.item.expert.text.offset = 12,0
;   menu.item.expert.active.text.font = 1,0,1, 255, 160, 160
;   menu.header.expert.bg.spr = 6550,0
; --------------------------------------------------------------------------

; CURSOR -------------------------------------------------------------------
; Drawn on the active row, under its text.
menu.cursor.offset = 0,0
menu.cursor.spr = 
menu.cursor.anim = -1
menu.cursor.scale = 1.0, 1.0
menu.cursor.facing = 1
menu.cursor.displaytime = -1
menu.cursor.layerno = 0

; CLEAR MARKER -------------------------------------------------------------
; Whether a trial has been cleared, shown at menu.status.offset from the row's origin.
; Name a sprite or an anim and it is drawn there; leave both unset and the .text label is drawn
; instead. That is the swap: point status.cleared.spr at your own sprite and it replaces the
; "CLEAR" text. Set a state's text to "" and leave its art unset to show nothing for that state.
; Only one of the two is ever drawn, so .scale applies to whichever it is - size it for your
; sprite once you name one.
menu.status.offset = 500,0
menu.status.cleared.offset = 0,0
menu.status.cleared.spr = 
menu.status.cleared.anim = -1
menu.status.cleared.scale = 2,2
menu.status.cleared.facing = 1
menu.status.cleared.displaytime = -1
menu.status.cleared.layerno = 0
menu.status.cleared.text = "CLEAR"
menu.status.cleared.font = 1,0,1, 120, 255, 160
menu.status.cleared.font.height = -1
menu.status.uncleared.offset = 0,0
menu.status.uncleared.spr = 
menu.status.uncleared.anim = -1
menu.status.uncleared.scale = 2,2
menu.status.uncleared.facing = 1
menu.status.uncleared.displaytime = -1
menu.status.uncleared.layerno = 0
menu.status.uncleared.text = "----"
menu.status.uncleared.font = 1,0,1, 130, 130, 130
menu.status.uncleared.font.height = -1

; Rows a gated file has not opened yet ([Tutorial] tutorial.gated = true in the file).
menu.status.locked.offset = 0,0
menu.status.locked.spr = 
menu.status.locked.anim = -1
menu.status.locked.scale = 2,2
menu.status.locked.facing = 1
menu.status.locked.displaytime = -1
menu.status.locked.layerno = 0
menu.status.locked.text = "LOCKED"
menu.status.locked.font = 1,0,1, 110, 110, 110
menu.status.locked.font.height = -1

; BEST TIME ----------------------------------------------------------------
; %s is the best clear time. Set text to "" to leave times off the menu entirely.
menu.besttime.offset = 640,0
menu.besttime.font = 1,0,-1, 190, 190, 190
menu.besttime.scale = 2,2
menu.besttime.font.height = -1
menu.besttime.text = "%s"

