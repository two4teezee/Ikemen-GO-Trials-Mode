; --------------------------------------------------------------------------
; MODE SECTIONS
; Each is laid over [Dojo] for its own modes. Only the keys listed differ from the shared look;
; add any [Dojo] key to style that mode apart.
; --------------------------------------------------------------------------

[Trials Mode]
; Trials.
title.vertical.text.text = "Trial: %s"
title.horizontal.text.text = "Trial: %s"
counter.text = "Trial %s of %t"
counter.allclear.text = "All Trials Clear"
counter.nodata.text = "No Trials Data Found"
totaltimer.text = "Trial Timer: %s"
currenttimer.text = "Current Trial: %s"
menu.title.text = "Trial Selection"

[Tutorial Mode]
; The Game Tutorial and Character Guides.
title.vertical.text.text = "Lesson: %s"
title.horizontal.text.text = "Lesson: %s"
counter.text = "Lesson %s of %t"
counter.allclear.text = "All Lessons Clear"
counter.nodata.text = "No lessons for this character"
totaltimer.text = "Total Time: %s"
currenttimer.text = "Lesson Time: %s"
menu.title.text = "Lessons"

; ANIMATIONS -------------------------------------------------------------
; Actions for "anim" parameters in any section. Sprite numbers refer to dojo.sff.
; ------------------------------------------------------------------------

[Begin Action 65510] ; Up arrow for trials menu
6551,0, 0,0, 20,,AS0D256, 1,1, 90
Interpolate Blend
6551,0, 0,0, 60,,AS128D128, 1,1, 90
Interpolate Blend
6551,0, 0,0, 20,,AS0D256, 1,1, 90

[Begin Action 65511] ; Down arrow for trials menu
6551,0, 16,0, 20,,AS0D256, 1,1, 270
Interpolate Blend
6551,0, 16,0, 60,,AS128D128, 1,1, 270
Interpolate Blend
6551,0, 16,0, 20,,AS0D256, 1,1, 270