title.horizontal.front.facing = 1
title.horizontal.front.displaytime = -1
title.horizontal.front.layerno = 0

; TRIALSTEPS OPTIONS -------------------------------------------------------
; TRIALSTEPS options can be specified for both vertical and horizontal layouts simultaneously.
; steps.<layout>.pos: local origin from which trial steps are drawn. Other elements have their own origin specifications.
; steps.<layout>.spacing: spacing between trial steps. For horizontal layout, the second argument determines the spacing between rows.
; steps.<layout>.window: X1,Y1,X2,Y2: display window for trials--will create automated scrolling or line returns, depending on the trial layout of choice
; steps.horizontal.padding: horizontal layouts only - padding between glyphs and edges of the background element along the x (horizontal) axis.
; steps.<layout>.bg. ...: optional background displayed behind all other trial step text, background elements, etc.
; TRIALSTEPS VERTICAL ------------------------------------------------------
steps.vertical.anchor = left
steps.vertical.pos = 140,190
steps.vertical.spacing = 0,25
steps.vertical.window.withouttextbox = 100,175, 1180,550
steps.vertical.window.withtextbox = 100,175, 1180,550

steps.vertical.bg.offset = 0, 0
steps.vertical.bg.spr = 
steps.vertical.bg.anim = -1
steps.vertical.bg.scale = 1.0, 1.0
steps.vertical.bg.facing = 1
steps.vertical.bg.displaytime = -1
steps.vertical.bg.layerno = 0
; TRIALSTEPS HORIZONTAL ----------------------------------------------------
steps.horizontal.anchor = left
steps.horizontal.pos = 140,180
steps.horizontal.spacing = 0,40
steps.horizontal.window.withouttextbox = 100,175, 1180,550
steps.horizontal.window.withtextbox = 100,175, 780,550
steps.horizontal.padding = 10

steps.horizontal.bg.offset = 0, 0
steps.horizontal.bg.spr = 
steps.horizontal.bg.anim = -1
steps.horizontal.bg.scale = 1.0, 1.0
steps.horizontal.bg.facing = 1
steps.horizontal.bg.displaytime = -1
steps.horizontal.bg.layerno = 0

