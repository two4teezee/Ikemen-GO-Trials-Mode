menu.arrow.up.offset = 660, 0
menu.arrow.up.spr = 
menu.arrow.up.anim = 65510
menu.arrow.up.scale = 1,1
menu.arrow.up.facing = 1
menu.arrow.up.displaytime = -1
menu.arrow.up.layerno = 0
