; What the progress-clearing rows read back, both of them. They show nothing until the progress has
; been erased, and then say so - the pause menu sits over a frozen match, so nothing else on screen
; would change.
menu.valuename.trialsclearprogress_ready =
menu.valuename.trialsclearprogress_cleared = Cleared

; Trial select view: the difficulty filters left and right cycle through. "All" is every Trial;
; "Other" collects the ones whose def declares no trial.difficulty. Filters with no Trials in
; them are skipped. Everything else about the view's appearance is [Trials Mode] trialsmenu.*.
menu.valuename.trialsdifficulty_all = All
menu.valuename.trialsdifficulty_beginner = Beginner
menu.valuename.trialsdifficulty_intermediate = Intermediate
menu.valuename.trialsdifficulty_advanced = Advanced
menu.valuename.trialsdifficulty_expert = Expert
menu.valuename.trialsdifficulty_none = Other

