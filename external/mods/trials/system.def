[Trials Mode]

; TITLE SCREEN --------------------------------------------------------------------
; The title of the mode, shown on the title screen and in the menu. 
; Screenpacks can override this with their own title, but if they don't, this is what is shown.
; -----------------------------------------------------------------------------------
menu.itemname.trials = "TRIALS MODE"

; SELECT SCREEN --------------------------------------------------------------------
; The palette effect applied to the cell portrait of every character that ships NO Trial
; Definition, for as long as Trials Mode is the mode being selected for. 
; -----------------------------------------------------------------------------------
selscreenpalfx.mul = 100, 100, 100
selscreenpalfx.color = 0
; selscreenpalfx.add =
; selscreenpalfx.sinadd =
; selscreenpalfx.invertall =

; LOCALCOORD ----------------------------------------------------------------------
; You can force the module's localcoord if needed.
; -----------------------------------------------------------------------------------
; trials.localcoord =

; TRIALS COUNTER ------------------------------------------------------------------
; Shows which Trial the player is on, and how many are available.
; The text argument is a format string, with %i for the current Trial number and %s for the total number of Trials.
; nodata.text is the string displayed when no Trials are available for the character.
; -----------------------------------------------------------------------------------
trialcounter.text = "Trial %i of %s"
trialcounter.allclear.text = "All Trials Clear"
trialcounter.font = 1, 0, 1
trialcounter.scale = 1, 1
trialcounter.layerno = 0
trialcounter.pos = 5, 228
; trialcounter.offset =
; trialcounter.font.height =
; trialcounter.window =
; trialcounter.localcoord =
nodata.text = "No trials available for this character."

; TRIAL TITLE ----------------------------------------------------------------------
; The name of the Trial being played, optionally drawn element.
;
; %i is the Trial's number and %s its name, the engine's own substitution convention
; (main.f_formatBySpec), the same one the Textbox title takes. The pre-refactor spelling
; — %s for the number, %n for the name — is still read, and writing %n anywhere in the
; string is what selects it.
; -----------------------------------------------------------------------------------
