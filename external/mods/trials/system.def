; TRIAL STEPS BACKGROUND ELEMENTS ---------------------------------------------------
; Background elements can be specified for each trial step status, for both vertical and horizontal layouts.
; For horizontal layouts, the background is split into three elements: tail, body, and head. 
; The body is stretched to fit the width of the step, while the tail and head are fixed width.
; -----------------------------------------------------------------------------------
upcomingstep.vertical.bg.offset = -2, -7
upcomingstep.vertical.bg.spr = 0, 10
