; TRIAL SELECT MENU --------------------------------------------------------
; The menu of the character's trials, shown when the match loads and again whenever the player
; picks "Trials List" from the pause menu. It is drawn by the module, so everything about it is
; configured here rather than in the screenpack's [Trials Pause Menu] section.
;
; Rows are laid out from trialsmenu.pos, trialsmenu.spacing apart, trialsmenu.visibleitems at a
; time. A row is one of three kinds, each with its own text and background:
;   header - the difficulty filter, shown only when the character has more than one to cycle
;   item   - a trial. Uses .active when the cursor is on it, .selected for the trial in play
;   (the section's own tail items, "Back" among them, are drawn as plain items)
;
; Every bg/front/cursor/status element takes the usual spr, anim, offset, scale, facing,
; displaytime and layerno parameters. Leave spr empty and anim at -1 to draw nothing.
; --------------------------------------------------------------------------
; trialsmenu.layerno is the layer every element in this block sits on unless it names its own.
; The menu covers a live match, so it defaults to 2 rather than sharing layer 0 with the HUD.
trialsmenu.layerno = 2
trialsmenu.pos = 340,180
trialsmenu.spacing = 0,26
trialsmenu.visibleitems = 9
; trialsmenu.window clips every row's text to this rectangle. Leave unset for no clipping.
trialsmenu.window = 
trialsmenu.bg.offset = 0,-40
trialsmenu.bg.spr = 
trialsmenu.bg.anim = -1
trialsmenu.bg.scale = 1.0, 1.0
trialsmenu.bg.facing = 1
trialsmenu.bg.displaytime = -1
trialsmenu.bg.layerno = 0
trialsmenu.front.offset = 0,-40
trialsmenu.front.spr = 
trialsmenu.front.anim = -1
trialsmenu.front.scale = 1.0, 1.0
trialsmenu.front.facing = 1
trialsmenu.front.displaytime = -1
trialsmenu.front.layerno = 0
; trialsmenu.overlay dims whatever is behind the menu. Set visible to false to leave the match visible.
; alpha is source,destination, the same as every other overlay in the engine: 0,128 halves what is
; behind it. Raising the first number adds col to the picture rather than dimming it.
trialsmenu.overlay.visible = true
trialsmenu.overlay.window = 0,0,1280,720
trialsmenu.overlay.col = 0,0,0
trialsmenu.overlay.alpha = 0,128
trialsmenu.overlay.layerno = 0

; TITLE --------------------------------------------------------------------
trialsmenu.title.offset = 0,-60
trialsmenu.title.font = 1,0,0, 255, 255, 255
trialsmenu.title.scale = 2,2
trialsmenu.title.font.height = -1
trialsmenu.title.text = "Trials Selection"

; FILTER HEADER ------------------------------------------------------------
; The difficulty filter the player cycles with left and right, and how many of it are cleared.
; It is pinned: trialsmenu.header.offset places it relative to trialsmenu.pos and it stays there
; while the rows scroll underneath. The text and value offsets are relative to the banner.
;
; trialsmenu.headerdisplay picks the shape:
;   default    - one banner, naming the filter on show. Arrows mark that there are others.
;   sidebyside - every filter laid out at trialsmenu.header.spacing apart, the one on show
;                wearing the trialsmenu.header.active elements below.
;
; trialsmenu.header.active.* styles the filter on show. It inherits from the plain header
; elements, so leaving it out means both look the same - which is what "default" has always
; done, and what makes side by side need a highlight of its own before it reads.
;
; trialsmenu.header.value.text formats the tally; "" leaves it off, which side by side often
; wants once six of them are on one line.
trialsmenu.headerdisplay = default
trialsmenu.header.offset = 0,-30
trialsmenu.header.spacing = 150,0
trialsmenu.header.text.offset = 0,0
trialsmenu.header.text.font = 1,0,1, 255, 220, 120
trialsmenu.header.text.scale = 2,2
trialsmenu.header.text.font.height = -1
trialsmenu.header.value.offset = 300,0
trialsmenu.header.value.font = 1,0,-1, 255, 220, 120
trialsmenu.header.value.scale = 2,2
trialsmenu.header.value.font.height = -1
trialsmenu.header.value.text = "%s"
; The filter on show. Declare only what should differ from the elements above.
trialsmenu.header.active.text.font = 1,0,1, 255, 255, 255
trialsmenu.header.active.value.font = 1,0,-1, 255, 255, 255
trialsmenu.header.bg.offset = 0,0
trialsmenu.header.bg.spr = 
trialsmenu.header.bg.anim = -1
trialsmenu.header.bg.scale = 1.0, 1.0
trialsmenu.header.bg.facing = 1
trialsmenu.header.bg.displaytime = -1
trialsmenu.header.bg.layerno = 0

; ROWS ---------------------------------------------------------------------
trialsmenu.item.text.offset = 0,0
trialsmenu.item.text.font = 1,0,1, 190, 190, 190
trialsmenu.item.text.scale = 2,2
trialsmenu.item.text.font.height = -1
trialsmenu.item.bg.offset = 0,0
trialsmenu.item.bg.spr = 
trialsmenu.item.bg.anim = -1
trialsmenu.item.bg.scale = 1.0, 1.0
trialsmenu.item.bg.facing = 1
trialsmenu.item.bg.displaytime = -1
trialsmenu.item.bg.layerno = 0
; .active is the row the cursor is on.
trialsmenu.item.active.text.offset = 0,0
trialsmenu.item.active.text.font = 1,0,1, 255, 255, 255
trialsmenu.item.active.text.scale = 2,2
trialsmenu.item.active.text.font.height = -1
trialsmenu.item.active.bg.offset = 0,0
trialsmenu.item.active.bg.spr = 
trialsmenu.item.active.bg.anim = -1
trialsmenu.item.active.bg.scale = 1.0, 1.0
trialsmenu.item.active.bg.facing = 1
trialsmenu.item.active.bg.displaytime = -1
trialsmenu.item.active.bg.layerno = 0
; .selected is the trial currently in play, whether or not the cursor is on it.
trialsmenu.item.selected.text.offset = 0,0
trialsmenu.item.selected.text.font = 1,0,1, 120, 255, 160
trialsmenu.item.selected.text.scale = 2,2
trialsmenu.item.selected.text.font.height = -1

; PER-CATEGORY OVERRIDES ---------------------------------------------------
; Any of the row and banner elements above can be respecified for one difficulty category, by
; putting the category name straight after "item" or "header":
;
;   trialsmenu.item.<category>.text.*            a trial of that difficulty, at rest
;   trialsmenu.item.<category>.active.text.*     ...under the cursor
;   trialsmenu.item.<category>.selected.text.*   ...when it is the trial in play
;   trialsmenu.item.<category>.bg.*              its row background
;   trialsmenu.item.<category>.active.bg.*       ...under the cursor
;   trialsmenu.header.<category>.text.*          the banner, while that filter is showing
;   trialsmenu.header.<category>.value.*         its cleared tally
;   trialsmenu.header.<category>.bg.*            its background
;
; Categories for a row are beginner, intermediate, advanced, expert and other ("other" being the
; trials whose def declares no trial.difficulty). The banner adds "all", the unfiltered view.
;
; Declare only what differs: anything a category leaves out is inherited from the shared element
; it overrides, so a colour change is one line. A category with no block at all is drawn exactly
; as before. Offsets are relative to the row, so a category can sit somewhere else on the line.
;
; For example, to make Expert trials red, shift them right, and give the Expert banner its own
; sprite, without touching anything else:
;
;   trialsmenu.item.expert.text.font = 1,0,1, 255, 90, 90
;   trialsmenu.item.expert.text.offset = 12,0
;   trialsmenu.item.expert.active.text.font = 1,0,1, 255, 160, 160
trialsmenu.header.expert.bg.spr = 6550,0
; --------------------------------------------------------------------------

; CURSOR -------------------------------------------------------------------
; Drawn on the active row, under its text.
trialsmenu.cursor.offset = 0,0
trialsmenu.cursor.spr = 
trialsmenu.cursor.anim = -1
trialsmenu.cursor.scale = 1.0, 1.0
trialsmenu.cursor.facing = 1
trialsmenu.cursor.displaytime = -1
trialsmenu.cursor.layerno = 0

; CLEAR MARKER -------------------------------------------------------------
; Whether a trial has been cleared, shown at trialsmenu.status.offset from the row's origin.
; Name a sprite or an anim and it is drawn there; leave both unset and the .text label is drawn
; instead. That is the swap: point status.cleared.spr at your own sprite and it replaces the
; "CLEAR" text. Set a state's text to "" and leave its art unset to show nothing for that state.
; Only one of the two is ever drawn, so .scale applies to whichever it is - size it for your
; sprite once you name one.
trialsmenu.status.offset = 300,0
trialsmenu.status.cleared.offset = 0,0
trialsmenu.status.cleared.spr = 
trialsmenu.status.cleared.anim = -1
trialsmenu.status.cleared.scale = 2,2
trialsmenu.status.cleared.facing = 1
trialsmenu.status.cleared.displaytime = -1
trialsmenu.status.cleared.layerno = 0
trialsmenu.status.cleared.text = "CLEAR"
trialsmenu.status.cleared.font = 1,0,1, 120, 255, 160
trialsmenu.status.cleared.font.height = -1
trialsmenu.status.uncleared.offset = 0,0
trialsmenu.status.uncleared.spr = 
trialsmenu.status.uncleared.anim = -1
trialsmenu.status.uncleared.scale = 2,2
trialsmenu.status.uncleared.facing = 1
trialsmenu.status.uncleared.displaytime = -1
trialsmenu.status.uncleared.layerno = 0
trialsmenu.status.uncleared.text = "----"
trialsmenu.status.uncleared.font = 1,0,1, 130, 130, 130
trialsmenu.status.uncleared.font.height = -1

; BEST TIME ----------------------------------------------------------------
; %s is the best clear time. Set text to "" to leave times off the menu entirely.
trialsmenu.besttime.offset = 420,0
trialsmenu.besttime.font = 1,0,-1, 190, 190, 190
trialsmenu.besttime.scale = 2,2
trialsmenu.besttime.font.height = -1
trialsmenu.besttime.text = "%s"

; SCROLL ARROWS ------------------------------------------------------------
; Shown when the list runs past trialsmenu.visibleitems in that direction. Offsets are relative
; to trialsmenu.pos. Like the clear marker, each arrow takes either art or a label: name a sprite
; or an anim and it is drawn, leave both unset and .text is drawn instead. Only one of the two is
; ever drawn, so .scale applies to whichever it is. Set .text to "" with no art to hide an arrow.
trialsmenu.arrow.up.offset = 300,-20
trialsmenu.arrow.up.spr = 
trialsmenu.arrow.up.anim = -1
trialsmenu.arrow.up.scale = 2,2
trialsmenu.arrow.up.facing = 1
trialsmenu.arrow.up.displaytime = -1
trialsmenu.arrow.up.layerno = 0
trialsmenu.arrow.up.text = "^"
trialsmenu.arrow.up.font = 1,0,0, 255, 255, 255
trialsmenu.arrow.up.font.height = -1
trialsmenu.arrow.down.offset = 300,240
trialsmenu.arrow.down.spr = 
trialsmenu.arrow.down.anim = -1
trialsmenu.arrow.down.scale = 2,2
trialsmenu.arrow.down.facing = 1
trialsmenu.arrow.down.displaytime = -1
trialsmenu.arrow.down.layerno = 0
trialsmenu.arrow.down.text = "v"
trialsmenu.arrow.down.font = 1,0,0, 255, 255, 255
trialsmenu.arrow.down.font.height = -1
