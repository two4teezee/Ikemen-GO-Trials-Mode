; ===== TEST FIXTURE — artwork on the banners. DELETE THIS BLOCK WHEN VERIFIED. =======
; The module ships no banner artwork, so there is nothing to look at until something
; declares some. This borrows sprites already in trials.sff:
;
;   Success   a static plate behind the word, and the arrow's point pulsing OVER it,
;             just to the right — which is what tells .bg from .front on screen.
;   All-Clear the same plate, animated: it is the one that proves an action restarts
;             each time a banner is raised, since All-Clear fires once per set.
;
; Offsets are from each banner's own pos (160, 100) in this file's 320x240 space. The
; plate is 280 x 36 drawn from its top-left corner, so -140 centres it.
success.bg.spr = 0, 1
success.bg.offset = -140, -30
success.bg.layerno = 0
success.front.anim = 22
success.front.offset = 60, -20
success.front.layerno = 0
allclear.bg.anim = 1
allclear.bg.offset = -140, -30
allclear.bg.layerno = 0
; ===== END TEST FIXTURE =============================================================

; REPOSITIONING --------------------------------------------------------------------
; trialresetenabled allows the user to reset the player and dummy position to center stage (or specified trials position) when the d and w keys are pressed simultaneously
; trialresetreminder displays a string that reminds the player they can reset the trial position with the specified key input
; fadeout and fadein are the transitions that play when the player resets the positions mid-Trial. 
; -----------------------------------------------------------------------------------
trialresetenabled = true

fadeout.time = 12
fadeout.col = 0, 0, 0
; fadeout.spr =
; fadeout.anim =
; fadeout.snd =
; fadeout.scale =
; fadeout.pos =
fadein.time = 12
fadein.col = 0, 0, 0
