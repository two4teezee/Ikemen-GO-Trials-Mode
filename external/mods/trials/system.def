; TRIAL STEPS — GENERAL SETTINGS ----------------------------------------------------
; TRIALSTEPS options can be specified for both vertical and horizontal layouts simultaneously.
;
; trialsteps.<layout>.pos: local origin from which trial steps are drawn. Other elements have their own origin specifications.
; trialsteps.<layout>.spacing: spacing between trial steps. For horizontal layout, the second argument determines the spacing between rows.
; trialsteps.<layout>.window: X1,Y1,X2,Y2: display window for trials--will create automated scrolling or line returns, depending on the trial layout of choice
; trialsteps.<layout>.pos.withtextbox: local origin from which trial steps are drawn when a textbox is present. Other elements have their own origin specifications.
; trialsteps.<layout>.window.withtextbox: X1,Y1,X2,Y2: display window for trials when a textbox is present--will create automated scrolling or line returns, depending on the trial layout of choice
; trialsteps.horizontal.padding: horizontal layouts only - padding between glyphs and edges of the background element along the x (horizontal) axis.
; -----------------------------------------------------------------------------------
trialsteps.vertical.pos = 35, 38
trialsteps.vertical.spacing = 0, 9
trialsteps.vertical.window = 25, 34, 295, 138
; trialsteps.vertical.pos.withtextbox =
; trialsteps.vertical.window.withtextbox =

trialsteps.horizontal.pos = 25, 38
trialsteps.horizontal.spacing = 4, 11
trialsteps.horizontal.window = 20, 34, 300, 70
trialsteps.horizontal.pos.withtextbox = 25, 38
trialsteps.horizontal.window.withtextbox = 20, 34, 250, 70
trialsteps.horizontal.padding = 2

; TRIAL STEPS TEXT OPTIONS -----------------------------------------------------
