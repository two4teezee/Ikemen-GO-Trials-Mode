; completedstep.vertical.glyphs.palfx.add =
; completedstep.vertical.glyphs.palfx.sinadd =
; completedstep.vertical.glyphs.palfx.invertall =

upcomingstep.horizontal.glyphs.palfx.mul = 180, 180, 180
