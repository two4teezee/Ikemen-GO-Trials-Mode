; TRIAL TEXTBOX --------------------------------------------------------------------
; A textbox can accompany each trial if it is specified within the trials definition file.
; The only element defined within the trials definition file is the text to be displayed for that trial.
;
; textbox.pos: local origin from which other textbox elements are drawn. 
; textbox.text.<options>: specify text window, offset, font type, and drawspeed
; textbox.title.<options>: specify text, offset, font type, scale
; textbox.overlay.<options>: draw an overlay behind any other bg, text or front element
; textbox.bg.<options>: optional background displayed behind text but over overlay; standard options for background elements, etc.
; textbox.front.<options>: optional background displayed in front of text; standard options for background elements, etc.
; textbox.portrait.<options>: allows a portrait to be drawn with or in the textbox. Sprite can be sourced from the character or the screenpack.
; -----------------------------------------------------------------------------------
textbox.pos = 20, 150
; textbox.localcoord =

textbox.title.text = "Trial %i: %s"
textbox.title.font = 1, 0, 1, 255, 220, 100
textbox.title.offset = 4, 8
; textbox.title.scale =
; textbox.title.font.height =
; textbox.title.layerno =

textbox.text.font = 1, 0, 1, 235, 235, 235
textbox.text.offset = 4, 20
; Stops short of y 228, where trialcounter.pos puts the Trial counter: the prose wraps
; inside this rect, so its last line has to clear the counter rather than sit over it.
textbox.text.window = 24, 158, 296, 216
textbox.text.wrap = true
textbox.text.delay = 0
textbox.text.spacing = 0, 10
; textbox.text.scale =
; textbox.text.font.height =
; textbox.text.layerno =

; textbox.bg.spr =
; textbox.bg.anim =
; textbox.bg.offset =
; textbox.bg.scale =
; textbox.bg.layerno =

; textbox.front.spr =
; textbox.front.anim =
; textbox.front.offset =
; textbox.front.scale =
; textbox.front.layerno =

textbox.portrait.source = char
textbox.portrait.spr = 9000, 0
textbox.portrait.offset = 250, 4
textbox.portrait.scale = 1, 1
; textbox.portrait.facing =
; textbox.portrait.window =
; textbox.portrait.layerno =

; TRIAL TIMERS --------------------------------------------------------------------
; trialresetenabled allows the user to reset the player and dummy position to center stage (or specified trials position) when the d and w keys are pressed simultaneously
; trialresetreminder displays a string that reminds the player they can reset the trial position with the specified key input
; 
; The framespercount option is how many ticks it takes to count one second, and is used to convert the engine's own tick count into a seconds display. The module ships 60, which is what the engine runs at, but a screenpack that runs at 30 or 120 can change it here.
; -----------------------------------------------------------------------------------
totaltrialtimer.text = "Total %s"
totaltrialtimer.font = 1, 0, -1
totaltrialtimer.scale = 1, 1
totaltrialtimer.layerno = 0
totaltrialtimer.pos = 315, 218
totaltrialtimer.framespercount = 60
; totaltrialtimer.offset =
; totaltrialtimer.font.height =
; totaltrialtimer.window =
; totaltrialtimer.localcoord =

currenttrialtimer.text = "Trial %s"
currenttrialtimer.font = 1, 0, -1
currenttrialtimer.scale = 1, 1
currenttrialtimer.layerno = 0
currenttrialtimer.pos = 315, 228
currenttrialtimer.framespercount = 60
; currenttrialtimer.offset =
; currenttrialtimer.font.height =
; currenttrialtimer.window =
; currenttrialtimer.localcoord =

