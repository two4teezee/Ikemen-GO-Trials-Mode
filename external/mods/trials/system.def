; TRIALS MODE — trials-specific motif defaults
;
; Deliberately NOT named "+system.def". The engine auto-merges files with that name
; and logs a warning for every key its motif struct cannot assign, so trials-specific
; keys placed there would produce a warning per key on every boot. This file is read
; only by the module, via loadIni, and the engine never parses it.
;
; This is layer 1 of three. The module reads its own config.ini over it, and the
; screenpack's system.def over that — so a screenpack overrides any key below by
; defining the same section and key in its own system.def. Language variants use the
; engine's section-prefix convention, e.g. [ES.Trials Mode], resolved the way the
; engine resolves its own motif sections. See docs/adr/0001.
;
; Keys are dotted, matching how the engine's own element properties are written, and
; loadIni splits them into nested tables. Element keys follow the engine's own
; vocabulary — font, offset, scale, window, localcoord, layerno — so nothing here is a
; second dialect.

;-----------------------------------------------------------------------------------
[Trials Mode]
;-----------------------------------------------------------------------------------

; Label used when the module appends its own main-menu entry, and only then: a
; screenpack that defines [Title Info] menu.itemname.trials keeps full control.
menu.itemname.trials = "TRIALS"

; Shown in place of the counter when the selected character ships no Trial Definition.
; The pre-refactor spelling, trialcounter.notrialsdata.text, is still read: a screenpack
; that already sets it keeps working without an edit.
nodata.text = "No trials available for this character."

; SHARED --------------------------------------------------------------------------
; Settings more than one trials element reads live here rather than being repeated on
; each of them. An element may still carry its own value where it genuinely needs a
; different one; these are what it falls back to.
;
; trials.localcoord is the coordinate space every trials element draws in.
;
; You do not have to set it, and leaving it out never moves anything. The space follows
; whoever positioned the element:
;
;   - the positions in THIS file are written in 320x240, and resolve there
;   - a position your screenpack sets is written in your screenpack's localcoord, and
;     resolves there — which is what every existing trials integration already assumes,
;     so one that sets trialcounter.pos and nothing else keeps working unchanged
;   - setting trials.localcoord below overrides both
;
; Why 320x240 for this file's own coordinates: a match does not necessarily render at
; the screenpack's aspect ratio. With Video.FightAspect set to the stage's (the shipped
; default), a 4:3 stage renders 4:3 even in a 16:9 screenpack, and only the central 4:3
; slice of a widescreen localcoord is on screen. For 1280x720 that is x = 160 to 1120,
; so a default of "10 in from the left" would be invisible on exactly the setup this
; module ships against. 320x240 has no such margins.
; -----------------------------------------------------------------------------------
; trials.localcoord =

; TRIALS COUNTER ------------------------------------------------------------------
; Which Trial the player is on, and how many the character ships.
;
; %i is the current Trial and %s the total, following the engine's own substitution
; convention (main.f_formatBySpec). The pre-refactor "Trial %s of %t" spelling is still
; read the way it always was, so an existing screenpack needs no edit.
;
; pos is in 320x240, this file's own space (see trials.localcoord above). A pos you set
; in your screenpack is in your screenpack's space instead. trialcounter.localcoord
; overrides that for this one element only, and is almost never what you want.
; -----------------------------------------------------------------------------------
trialcounter.text = "Trial %i of %s"
; What the counter reads once every Trial has been completed. The All-Clear moment has
; its own banner below; this is what stays on screen after the banner has gone. Leave
; it out and the counter keeps reading the ordinary Trial count.
trialcounter.allclear.text = "All Trials Clear"
trialcounter.font = 1, 0, 1
trialcounter.scale = 1, 1
trialcounter.layerno = 0
trialcounter.pos = 5, 228
; trialcounter.offset =
; trialcounter.font.height =
; trialcounter.window =
; trialcounter.localcoord =

; TRIAL STEPS — VERTICAL LAYOUT ----------------------------------------------------
; The Steps of the current Trial, stacked. trialsteps.<layout> is the block the three
; Step Status elements below share: rows lay out from its pos, one spacing apart, and
; clip to its window. Each Step Status then spells only what distinguishes it.
;
; window is X1,Y1, X2,Y2. Once the rows no longer fit inside it the list scrolls,
; keeping two completed Steps above the current one. Leave it out for no clipping.
;
; The .withtextbox variants are used for a Trial that carries a trial.textbox, so the
; two do not overlap. pos.withtextbox moves the block; window.withtextbox reshapes what
; it clips to. Both fall back to the plain key, so a config that sets neither behaves
; exactly as it did before.
;
; pos is in 320x240, this file's own space (see trials.localcoord above).
; -----------------------------------------------------------------------------------
trialsteps.vertical.pos = 35, 38
trialsteps.vertical.spacing = 0, 9
trialsteps.vertical.window = 25, 34, 295, 138
trialsteps.vertical.pos.withtextbox =
trialsteps.vertical.window.withtextbox =

; STEP STATUS — VERTICAL LAYOUT ----------------------------------------------------
; Where a Step sits relative to the player's progress: upcoming, current, or completed.
; Each is styled independently so progress is legible at a glance — here by colour
; alone, the fourth to sixth font slots, so the three read as one list.
;
; offset is added to the block's pos, per Step Status. Everything an engine text
; element takes works here too: scale, font.height, layerno. The window is the one
; exception — it belongs to the block above, because it is what switches when a Trial
; carries a Textbox, and all three Step Statuses have to clip to the same rect.
; -----------------------------------------------------------------------------------
upcomingstep.vertical.text.font = 1, 0, 1, 180, 180, 180
upcomingstep.vertical.text.offset = 0, 0
; upcomingstep.vertical.text.scale =
; upcomingstep.vertical.text.font.height =

currentstep.vertical.text.font = 1, 0, 1, 255, 255, 255
currentstep.vertical.text.offset = 0, 0
; currentstep.vertical.text.scale =
; currentstep.vertical.text.font.height =

completedstep.vertical.text.font = 1, 0, 1, 110, 110, 110
completedstep.vertical.text.offset = 0, 0
; completedstep.vertical.text.scale =
; completedstep.vertical.text.font.height =

; TRIAL STEPS — HORIZONTAL LAYOUT --------------------------------------------------
; The same Steps flowed along a row instead of stacked, so the block is a ribbon a few
; rows deep rather than a column. Which of the two is drawn is the player's, not the
; screenpack's: the Layout preference in the module's config.ini, switchable from the
; trials pause menu mid-match. Both blocks are built at load, so switching between them
; is instant and a screenpack styles each independently.
;
; Steps lay out from pos, left to right, one spacing (first argument) apart. A Step that
; would not fit inside the window's right edge starts a new row, one spacing (second
; argument) down — so here the second argument is the row height, where in the vertical
; block it is what separates one Step from the next.
;
; padding is the gap between a Step's text and the edges of its own item, applied on
; both sides. It is what a background element drawn behind the Step needs in order not
; to touch the words; with no background it simply insets the row.
;
; window is X1,Y1, X2,Y2. Its right edge is where rows wrap, and its bottom is how many
; of them are shown: once the rows no longer fit, the list scrolls to keep the row the
; player is on in view, exactly as the vertical block scrolls its Steps. Leave the window
; out and rows wrap at the edge of the screen instead of not at all.
;
; The shipped origin is the vertical block's, and for a reason worth knowing before
; moving it: the engine's own lifebars and power bars end around y = 32 in this space, so
; a row drawn any higher than that sits across them.
;
; pos is in 320x240, this file's own space (see trials.localcoord above).
; -----------------------------------------------------------------------------------
trialsteps.horizontal.pos = 25, 38
trialsteps.horizontal.spacing = 4, 11
trialsteps.horizontal.padding = 2
trialsteps.horizontal.window = 20, 34, 300, 70
trialsteps.horizontal.pos.withtextbox = 25, 38
trialsteps.horizontal.window.withtextbox = 20, 34, 250, 70

; STEP STATUS — HORIZONTAL LAYOUT --------------------------------------------------
; Styled apart the same way the vertical Layout's three are, and independently of them:
; a screenpack that wants the row to read differently from the column says so here.
; -----------------------------------------------------------------------------------
upcomingstep.horizontal.text.font = 1, 0, 1, 180, 180, 180
upcomingstep.horizontal.text.offset = 0, 0
; upcomingstep.horizontal.text.scale =
; upcomingstep.horizontal.text.font.height =

currentstep.horizontal.text.font = 1, 0, 1, 255, 255, 255
currentstep.horizontal.text.offset = 0, 0
; currentstep.horizontal.text.scale =
; currentstep.horizontal.text.font.height =

completedstep.horizontal.text.font = 1, 0, 1, 110, 110, 110
completedstep.horizontal.text.offset = 0, 0
; completedstep.horizontal.text.scale =
; completedstep.horizontal.text.font.height =

; STEP BACKGROUNDS ------------------------------------------------------------------
; The artwork drawn behind the Steps: what makes Step text and Glyphs readable over a
; busy stage, and what gives a screenpack its identity in this mode.
;
; Two kinds, both per Layout:
;
;   trialsteps.<layout>.bg.*      one background behind the whole Step list
;   <status>step.<layout>.bg.*    one under each Step, styled per Step Status
;
; Every element takes the ordinary engine keys — spr, anim, offset, scale, facing,
; window, localcoord, layerno — and draws behind the Step text at the same layer number,
; because elements sharing a layer draw in the order they are drawn in and the module
; draws these first.
;
; TO TURN ONE OFF, set its spr to nothing:
;
;   currentstep.horizontal.bg.spr =
;   currentstep.horizontal.bg.tail.spr =
;   currentstep.horizontal.bg.head.spr =
;
; All three, in the horizontal Layout — they are separate elements and clearing the body
; leaves the head and tail. A Step Status with no background draws none and reserves no
; room for one, so its Steps lay out exactly as they would if this section were not here.
;
; ONE CASE WHERE THESE DEFAULTS DROP THEMSELVES. If your screenpack sets
; trialsteps.<layout>.pos, the block resolves into YOUR coordinate space, and the sprites
; below are drawn at 320x240 — the shipped 280-unit panel would cover a quarter of the
; width it was drawn for at 1280x720. So the module's own artwork is dropped rather than
; drawn at the wrong scale, exactly as the block's own default window is. Style your own
; backgrounds here and they are used as written; that is what this section is for.
;
; WHICH FILE A SPRITE NUMBER MEANS. `spr = 0, 10` below is a sprite in the module's own
; trials.sff. The same key in YOUR system.def is a sprite in YOUR sff — the file follows
; whoever wrote the key, exactly as the coordinate space does. There is no way to mix
; the two on one element, and no reason to want to: state the key and the file that goes
; with it comes along. trials.sff is only ever loaded if something still resolves to it,
; so a screenpack that styles every element of its own never pays for a second copy.
;
; `spr` and not `anim`, on both sides. Every element here is one static sprite, so the
; module ships no .air; and a screenpack's own [Begin Action N] cannot reach a Lua module
; at all, because the engine's action table is unexported. Writing `anim = N` here draws
; nothing and says so in the console. Use `spr = group, index`.
;
; THE HORIZONTAL LAYOUT'S THREE PIECES. A vertical row is a fixed-width slot, so its
; background is one sprite drawn where the row is. A horizontal Step is only as wide as
; whatever it renders, so its background is an arrow in three parts:
;
;   .bg.tail.*   the nock, fixed width, drawn at the start of the Step
;   .bg.*        the shaft, STRETCHED along x to the width of that Step's own content
;   .bg.head.*   the point, fixed width, drawn at the end of the Step
;
; The body is stretched and not tiled, which is why the shipped one is four units wide
; and uniform across — a sprite with detail along x would smear. The head and tail are
; measured from their own sprites, and both are part of the width that decides where a
; row wraps: one item spans tail + padding + content + padding + head, with
; trialsteps.horizontal.spacing between items.
;
; Content is the Step's text AND its Glyphs together. The pre-refactor module drew
; Glyphs alone in this Layout and sized the background to the Glyph line, so a Trial
; Definition shipping no Glyphs collapsed to nothing; here it gets a background sized to
; its words.
;
; palfx belongs to the whole background, head and tail included — they are one graphic,
; and tinting the shaft without its point would read as a seam. The shipped muls are the
; grey levels the three Step Statuses already dim their text and Glyphs by, so a
; completed Step reads as completed all the way through. 256 is neutral.
;
; offsets are in 320x240, this file's own space (see trials.localcoord above), and are
; measured from trialsteps.<layout>.pos. The shipped ones put each block background over
; exactly the window its Layout clips to, and each Step background around the row it
; sits under — a sprite font draws its line above the y it is given (src/font.go:636),
; which is why the y offsets are negative.
; -----------------------------------------------------------------------------------
trialsteps.vertical.bg.spr = 0, 0
trialsteps.vertical.bg.offset = -10, -4
trialsteps.vertical.bg.layerno = 0
; trialsteps.vertical.bg.scale =
; trialsteps.vertical.bg.facing =

trialsteps.horizontal.bg.spr = 0, 1
trialsteps.horizontal.bg.offset = -5, -4
trialsteps.horizontal.bg.layerno = 0
; trialsteps.horizontal.bg.scale =
; trialsteps.horizontal.bg.facing =

; One plate per row in the vertical Layout, the same sprite under all three Step
; Statuses and told apart by its palfx alone — which is what keeps the list reading as
; one list rather than as three kinds of thing.
upcomingstep.vertical.bg.spr = 0, 10
upcomingstep.vertical.bg.offset = -2, -7
upcomingstep.vertical.bg.palfx.mul = 180, 180, 180

currentstep.vertical.bg.spr = 0, 10
currentstep.vertical.bg.offset = -2, -7
currentstep.vertical.bg.palfx.mul = 255, 255, 255

completedstep.vertical.bg.spr = 0, 10
completedstep.vertical.bg.offset = -2, -7
completedstep.vertical.bg.palfx.mul = 110, 110, 110

; The arrow, per Step Status. Tail 4 units wide, head 6; both are added to the width
; that decides where a row wraps, so changing a sprite here reflows the row.
upcomingstep.horizontal.bg.spr = 0, 20
upcomingstep.horizontal.bg.offset = 0, -7
upcomingstep.horizontal.bg.tail.spr = 0, 21
upcomingstep.horizontal.bg.tail.offset = 0, -7
upcomingstep.horizontal.bg.head.spr = 0, 22
upcomingstep.horizontal.bg.head.offset = 0, -7
upcomingstep.horizontal.bg.palfx.mul = 180, 180, 180

currentstep.horizontal.bg.spr = 0, 20
currentstep.horizontal.bg.offset = 0, -7
currentstep.horizontal.bg.tail.spr = 0, 21
currentstep.horizontal.bg.tail.offset = 0, -7
currentstep.horizontal.bg.head.spr = 0, 22
currentstep.horizontal.bg.head.offset = 0, -7
currentstep.horizontal.bg.palfx.mul = 255, 255, 255

completedstep.horizontal.bg.spr = 0, 20
completedstep.horizontal.bg.offset = 0, -7
completedstep.horizontal.bg.tail.spr = 0, 21
completedstep.horizontal.bg.tail.offset = 0, -7
completedstep.horizontal.bg.head.spr = 0, 22
completedstep.horizontal.bg.head.offset = 0, -7
completedstep.horizontal.bg.palfx.mul = 110, 110, 110

; COMMAND GLYPHS ------------------------------------------------------------------
; The icons drawn beside a Step's text, standing in for the inputs its words describe.
; They come from the screenpack's own [Glyphs] vocabulary — the same one the engine's
; movelists use — so a Trial Definition writing `trialstep.1.glyphs = _QCF^P` gets the
; quarter-circle-forward and punch icons that screenpack already ships. A Step that
; declares no Glyphs draws as text alone, and a token this screenpack has no Glyph for
; is skipped rather than drawn.
;
; HOW BIG A GLYPH IS, and the one key that decides it: scalewithtext.
;
; ON (the default). A Glyph stands in for a word of the Step beside it, so it is sized
; from that Step Status's own font height and text scale — the engine sizes its movelist
; glyphs the same way. A Step Status a screenpack styles larger carries its Glyphs up
; with it, and the run always reads as part of the words.
;
;   scale is NOT READ while this is on. The size derived from the text replaces it,
;   which is what the pre-refactor toggle of the same name did.
;
; OFF. scale IS the size, exactly as written here, and nothing about the text enters
; into it. This is what to use for Glyphs sized absolutely — the pre-refactor default
; was an absolute 0.3125 — and it is the only way to draw Glyphs at a size the words do
; not dictate. A screenpack migrating a scalewithtext = false block keeps its old scale
; value unchanged.
;
; One case falls back on its own: with scalewithtext ON but no font resolvable for that
; Step Status — because its text.font is absent, so it draws no words — there is no
; height to match, and scale is used as written. The Glyphs still draw. That is the
; Glyph-only Step display the pre-refactor horizontal Layout was, and it needs no
; special spelling: leave the font out and set the scale you want.
;
; What is measured is the FONT's height, not the Step's string. A Step whose text is
; empty still sizes its Glyphs from the font its Step Status resolved, so a run does not
; change size from one Step to the next.
;
; align is the engine's own three: 1 grows the run right from its anchor, -1 ends it
; there, 0 centres it on it. It is the vertical Layout's alone, because aligning against
; an anchor only means something where the anchor stands still — see below.
;
; Where the run is anchored differs by Layout, because the two put a Step in a different
; kind of place:
;
;   vertical   — every row starts at trialsteps.vertical.pos, so offset is measured from
;                there. The run is a column beside text of varying length, which is what
;                the shipped right-aligned default makes of it.
;   horizontal — a Step sits wherever the flow put it, so offset is measured from the end
;                of that Step's own text and the run follows the words, always growing
;                right. It is also what separates the two, and a Step with no Glyphs is
;                laid out without it.
;
; spacing reads its first argument only: a run is a row, and there is nothing for a
; vertical gap between one Glyph and the next to mean.
;
; The y offset is a nudge, and 2 is the engine's own for the same job — its movelist
; ships movelist.glyphs.offset = 0, 2 in this same space. It is needed because text and
; sprites are positioned from different places: a sprite font draws its line above the y
; it is given (src/font.go:636) while a Glyph's Anim draws from its sprite axis, so the
; two only line up once the difference between them is spelled here. Expect to tune it
; for a screenpack whose font height or glyph axis differs from the stock one.
;
; offset and spacing are in 320x240, this file's own space (see trials.localcoord above).
; -----------------------------------------------------------------------------------
glyphs.vertical.offset = 230, 2
glyphs.vertical.scalewithtext = true
; Read only when scalewithtext is false, or when the Step Status resolved no font.
glyphs.vertical.scale = 1, 1
glyphs.vertical.spacing = 1, 0
glyphs.vertical.align = -1
glyphs.vertical.layerno = 0
; glyphs.vertical.localcoord =

glyphs.horizontal.offset = 3, 2
glyphs.horizontal.scalewithtext = true
; Read only when scalewithtext is false, or when the Step Status resolved no font.
glyphs.horizontal.scale = 1, 1
glyphs.horizontal.spacing = 1, 0
glyphs.horizontal.layerno = 0
; glyphs.horizontal.localcoord =

; GLYPH PALETTE EFFECTS -------------------------------------------------------------
; A Step Status styles its text by font and colour; this is how it styles the Glyphs
; drawn beside that text, so that upcoming, current and completed read apart as icons
; too. The keys are the engine's own palfx: add and mul are r,g,b; sinadd is r,g,b and
; a period; invertall is 0 or 1; color is 0-256, where 256 is the sprite's own colour
; and 0 is greyscale.
;
; The shipped muls are the grey levels the three Step Statuses already dim their text
; by above — 180, 255, 110 — so that a completed Step reads as completed all the way
; across rather than dimming its words and leaving its icons bright. 256 is neutral, so
; a screenpack that would rather its Glyphs never be tinted sets these to 256, 256, 256.
; -----------------------------------------------------------------------------------
upcomingstep.vertical.glyphs.palfx.mul = 180, 180, 180
currentstep.vertical.glyphs.palfx.mul = 255, 255, 255
completedstep.vertical.glyphs.palfx.mul = 110, 110, 110
; upcomingstep.vertical.glyphs.palfx.color =
; upcomingstep.vertical.glyphs.palfx.add =
; upcomingstep.vertical.glyphs.palfx.sinadd =
; upcomingstep.vertical.glyphs.palfx.invertall =

upcomingstep.horizontal.glyphs.palfx.mul = 180, 180, 180
currentstep.horizontal.glyphs.palfx.mul = 255, 255, 255
completedstep.horizontal.glyphs.palfx.mul = 110, 110, 110
; upcomingstep.horizontal.glyphs.palfx.color =
; currentstep.horizontal.glyphs.palfx.color =
; completedstep.horizontal.glyphs.palfx.color =

; TRIAL TEXTBOX --------------------------------------------------------------------
; The explanatory prose a Trial can carry, with an optional portrait. A Trial declares
; it with `trial.textbox` in its Trial Definition, and language variants with a key
; suffix — `trial.textbox.es`. A Trial that declares none draws no Textbox and no empty
; frame; whether a Trial that does declare one shows it is the player's, through
; [Options] Trials.Textboxes in config.ini.
;
; Note the asymmetry, which is deliberate: a Trial DEFINITION spells a language with a
; key suffix (trial.textbox.es), while this file spells one with a section prefix
; ([ES.Trials Mode]). The two files are read by different parsers.
;
; Five elements on one origin. textbox.pos positions all of them and each spells only its
; own offset, the way the Step Statuses share the Step block's origin. They draw in this
; order, so front is over the words and bg is behind them:
;
;   .bg        artwork behind the whole box
;   .portrait  the character being played, or a sprite from your sff
;   .title     one line, usually the Trial's number and name
;   .text      the Trial's own prose
;   .front     artwork over everything, for a frame or a gloss
;
; The whole Textbox draws behind the Steps, because the Step block moves out of its way
; rather than over it: see trialsteps.<layout>.pos.withtextbox and window.withtextbox
; above, which are what a Trial carrying a Textbox switches the Steps to.
;
; TITLE TEXT takes %i for the Trial's number and %s for its name, following the engine's
; own substitution convention. The pre-refactor spelling — %s for the number and %n for
; the name — is still read, and writing %n anywhere in the string is what selects it, so
; an existing screenpack needs no edit.
;
; BODY TEXT wraps inside textbox.text.window, which is doing two jobs: it is both what
; the prose is clipped to and what it wraps inside. Set it to the inside of your box.
; Wrapping is on unless you turn it off.
;
;   textbox.text.delay is frames per character, for prose that types itself out. 0 —
;   the default — is the whole of it at once. The pre-refactor key was `drawspeed`.
;   The reveal starts over whenever the Trial changes, and whenever a player switches
;   Textboxes back on.
;
; PORTRAIT SOURCE is `char` or `system`. `char` draws the character being played, from
; the sprites the select screen already preloaded — spr names which of that character's
; sprites, 9000,0 being the small portrait every character has. Its scale is corrected
; for the character's own coordinate space and portraitscale, so one scale here looks
; right across characters that disagree about either. `system` draws a sprite out of an
; sff, and follows the same rule every other element does: a spr this file ships means
; the module's trials.sff, one your screenpack writes means yours.
;
; WHERE THE SHIPPED ONE SITS, and one thing to know before moving it. The Textbox is one
; element set both Layouts share — there is one textbox.pos, not one per Layout — so the
; shipped position has to clear BOTH Layouts' Steps. The vertical block ends at y 138 and
; the horizontal one at y 70, so it sits below both, at y 150.
;
; trialsteps.horizontal.window.withtextbox reserves a right-hand strip instead, from a
; run at the screen. Nothing is drawn in that strip today, so a Trial carrying prose
; narrows the horizontal row for no gain. Reserving it costs one early row wrap; using it
; would need either a per-Layout textbox.pos or a Textbox that overlaps the vertical
; Layout's Steps. Left as tuned rather than quietly widened.
;
; pos is in 320x240, this file's own space (see trials.localcoord above). No artwork is
; shipped switched on: a Textbox frame is a screenpack's own furniture, and one drawn in
; artwork this module invented would sit oddly against every other screenpack. Give
; textbox.bg a spr and it appears.
; -----------------------------------------------------------------------------------
textbox.pos = 20, 150
; textbox.localcoord =

textbox.title.text = "Trial %i: %s"
textbox.title.font = 1, 0, 1, 255, 220, 100
textbox.title.offset = 4, 8
; textbox.title.scale =
; textbox.title.font.height =
; textbox.title.layerno =

textbox.text.font = 1, 0, 1, 235, 235, 235
textbox.text.offset = 4, 20
; Stops short of y 228, where trialcounter.pos puts the Trial counter: the prose wraps
; inside this rect, so its last line has to clear the counter rather than sit over it.
textbox.text.window = 24, 158, 296, 216
textbox.text.wrap = true
textbox.text.delay = 0
textbox.text.spacing = 0, 10
; textbox.text.scale =
; textbox.text.font.height =
; textbox.text.layerno =

; No shipped artwork — see above. spr here means the module's trials.sff; spr in your
; screenpack's system.def means yours.
; textbox.bg.spr =
; textbox.bg.offset =
; textbox.bg.scale =
; textbox.bg.layerno =

; textbox.front.spr =
; textbox.front.offset =
; textbox.front.scale =
; textbox.front.layerno =

textbox.portrait.source = char
textbox.portrait.spr = 9000, 0
textbox.portrait.offset = 250, 4
textbox.portrait.scale = 1, 1
; textbox.portrait.facing =
; textbox.portrait.window =
; textbox.portrait.layerno =

; TRIAL TIMERS --------------------------------------------------------------------
; Two stopwatches, both counting up: totaltrialtimer since the match began,
; currenttrialtimer since the current Trial started. Both freeze on All-Clear.
;
; The engine's own timers count DOWN and are driven by main.f_drawTimer, so its
; formula is not reusable here — but framespercount means the same thing in both, and
; is what a build running at something other than 60 ticks a second sets.
;
; %s is the elapsed time, formatted mm:ss:cc. Whether either timer is shown at all is
; a Player Preference, [Options] Trials.TotalTimer and Trials.TrialTimer in config.ini,
; not a screenpack setting: it is the player who wants to practise without a clock.
;
; pos is in 320x240, this file's own space (see trials.localcoord above).
; -----------------------------------------------------------------------------------
totaltrialtimer.text = "Total %s"
totaltrialtimer.font = 1, 0, -1
totaltrialtimer.scale = 1, 1
totaltrialtimer.layerno = 0
totaltrialtimer.pos = 315, 218
totaltrialtimer.framespercount = 60
; totaltrialtimer.offset =
; totaltrialtimer.font.height =
; totaltrialtimer.window =
; totaltrialtimer.localcoord =

currenttrialtimer.text = "Trial %s"
currenttrialtimer.font = 1, 0, -1
currenttrialtimer.scale = 1, 1
currenttrialtimer.layerno = 0
currenttrialtimer.pos = 315, 228
currenttrialtimer.framespercount = 60
