[Trials Mode]
; NOTE: Values provided in this sample meant for `mugen1` screenpack, 1280x720 resolution.
; Please modify the values in this file to properly configure the trials mode for your screenpack.
;
; GENERAL TRIALS OPTIONS ---------------------------------------------------
; trialsresetonsuccess: set to "true" to reset character positions after each trial success (except the final one). Can optionally specify fadein and fadeout parameters - will default to shown values.
; trialslayout: "vertical" or "horizontal" are the only valid values. Defaults to "vertical" if not specified. Affects scrolling logic, as stated above, also enables dynamic step width. Can be changed via the pause menu if screenpack author leaves the option in.
; --------------------------------------------------------------------------
trialsresetonsuccess = false
trialslayout = vertical

trialslocalcoord = 1280,720


; SELSCREENPALFX -----------------------------------------------------------
; Sets specified palfx color to character portraits WITHOUT trials files in the trials select screen. See definition for palfx for different fields and options.
; --------------------------------------------------------------------------
selscreenpalfx.color = 0
selscreenpalfx.invertall = ; 0
selscreenpalfx.sinadd = ; 0, 0, 0, 0
selscreenpalfx.mul = 100, 100, 100
selscreenpalfx.add = ; 0, 0, 0

; RESETONSUCCESS FADES -----------------------------------------------------
; Used when "trialsresetonsuccess" is set to "true"
; --------------------------------------------------------------------------
fadein.time = 40
fadein.col = {0, 0, 0}
fadein.anim = -1
fadeout.time = 40
fadeout.col = {0, 0, 0}
fadeout.anim = -1

; TRIALTITLE OPTIONS -------------------------------------------------------
; TRAILTITLE options can be specified for both vertical and horizontal layouts simultaneously.
; TRIALTITLE VERTICAL ------------------------------------------------------
trialtitle.vertical.pos = 140,140
trialtitle.vertical.text.offset = 0,-17
trialtitle.vertical.text.font = 6,0,1, 255, 200, 100
trialtitle.vertical.text.text = "Trial: %s"
trialtitle.vertical.text.scale = 1.0, 1.0
trialtitle.vertical.text.font.height = -1
trialtitle.vertical.bg.offset = 0, 0
trialtitle.vertical.bg.spr = 
trialtitle.vertical.bg.anim = -1
trialtitle.vertical.bg.scale = 1.0, 1.0
trialtitle.vertical.bg.facing = 1
trialtitle.vertical.bg.displaytime = -1
trialtitle.vertical.front.offset = 0, 0
trialtitle.vertical.front.spr = 
trialtitle.vertical.front.anim = -1
trialtitle.vertical.front.scale = 1.0, 1.0
trialtitle.vertical.front.facing = 1
trialtitle.vertical.front.displaytime = -1
; TRIALTITLE HORIZONTAL ----------------------------------------------------
trialtitle.horizontal.pos = 140,140
trialtitle.horizontal.text.offset = 0,-17
trialtitle.horizontal.text.font = 6,0,1, 255, 200, 100
trialtitle.horizontal.text.text = "Trial: %s"
trialtitle.horizontal.text.scale = 1.0, 1.0
trialtitle.horizontal.text.font.height = -1
trialtitle.horizontal.bg.offset = 0, 0
trialtitle.horizontal.bg.spr = 
trialtitle.horizontal.bg.anim = -1
trialtitle.horizontal.bg.scale = 1.0, 1.0
trialtitle.horizontal.bg.facing = 1
trialtitle.horizontal.bg.displaytime = -1
trialtitle.horizontal.front.offset = 0, 0
trialtitle.horizontal.front.spr = 
trialtitle.horizontal.front.anim = -1
trialtitle.horizontal.front.scale = 1.0, 1.0
trialtitle.horizontal.front.facing = 1
trialtitle.horizontal.front.displaytime = -1

; TRIALSTEPS OPTIONS -------------------------------------------------------
; TRIALSTEPS options can be specified for both vertical and horizontal layouts simultaneously.
; trialsteps.<layout>.pos: local origin from which trial steps are drawn. Other elements have their own origin specifications.
; trialsteps.<layout>.spacing: spacing between trial steps. For horizontal layout, the second argument determines the spacing between rows.
; trialsteps.<layout>.window: X1,Y1,X2,Y2: display window for trials--will create automated scrolling or line returns, depending on the trial layout of choice
; trialsteps.horizontal.padding: horizontal layouts only - padding between glyphs and edges of the background element along the x (horizontal) axis.
; trialsteps.<layout>.bg. ...: optional background displayed behind all other trial step text, background elements, etc.
; TRIALSTEPS VERTICAL ------------------------------------------------------
trialsteps.vertical.pos = 140,150
trialsteps.vertical.spacing = 0,25
trialsteps.vertical.window.withouttextbox = 100,175, 1180,550
trialsteps.vertical.window.withtextbox = 100,175, 1180,550
trialsteps.vertical.bg.offset = 0, 0
trialsteps.vertical.bg.spr = 
trialsteps.vertical.bg.anim = -1
trialsteps.vertical.bg.scale = 1.0, 1.0
trialsteps.vertical.bg.facing = 1
trialsteps.vertical.bg.displaytime = -1
; TRIALSTEPS HORIZONTAL ----------------------------------------------------
trialsteps.horizontal.pos = 140,175
trialsteps.horizontal.spacing = 1,40
trialsteps.horizontal.window.withouttextbox = 100,175, 1180,550
trialsteps.horizontal.window.withtextbox = 100,175, 780,550
trialsteps.horizontal.padding = 10
trialsteps.horizontal.bg.offset = 0, 0
trialsteps.horizontal.bg.spr = 
trialsteps.horizontal.bg.anim = -1
trialsteps.horizontal.bg.scale = 1.0, 1.0
trialsteps.horizontal.bg.facing = 1
trialsteps.horizontal.bg.displaytime = -1

; UPCOMINGSTEP -------------------------------------------------------------
; UPCOMINGSTEP options can be specified for both vertical and horizontal layouts simultaneously.
; UPCOMINGSTEP VERTICAL ----------------------------------------------------
upcomingstep.vertical.text.offset = 0,0
upcomingstep.vertical.text.font = 6,0,1, 200, 200, 200
upcomingstep.vertical.text.scale = 1.0, 1.0
upcomingstep.vertical.bg.offset = 0, 0
upcomingstep.vertical.bg.anim = -1
upcomingstep.vertical.bg.spr = 
upcomingstep.vertical.bg.scale = 1.0, 1.0
upcomingstep.vertical.bg.facing = 1
upcomingstep.vertical.bg.displaytime = -1
upcomingstep.vertical.bg.palfx.color = 200
upcomingstep.vertical.bg.palfx.invertall = 0
upcomingstep.vertical.bg.palfx.sinadd = 0, 0, 0, 0
upcomingstep.vertical.bg.palfx.mul = 200, 200, 200
upcomingstep.vertical.bg.palfx.add = 0, 0, 0
upcomingstep.vertical.glyphs.palfx.color = 256
upcomingstep.vertical.glyphs.palfx.invertall = 0
upcomingstep.vertical.glyphs.palfx.sinadd = 0, 0, 0, 0
upcomingstep.vertical.glyphs.palfx.mul = 0, 0, 0
upcomingstep.vertical.glyphs.palfx.add = 0, 0, 0
; UPCOMINGSTEP HORIZONTAL --------------------------------------------------
upcomingstep.horizontal.bg.offset = 0, 0
upcomingstep.horizontal.bg.anim = -1
upcomingstep.horizontal.bg.spr = 
upcomingstep.horizontal.bg.scale = 1.0, 1.0
upcomingstep.horizontal.bg.facing = 1
upcomingstep.horizontal.bg.displaytime = -1
upcomingstep.horizontal.bg.tail.offset = 0,-14
upcomingstep.horizontal.bg.tail.anim = -1
upcomingstep.horizontal.bg.tail.spr = 402,0
upcomingstep.horizontal.bg.tail.scale = 1.0, 1.0
upcomingstep.horizontal.bg.tail.facing = 1
upcomingstep.horizontal.bg.tail.displaytime = -1
upcomingstep.horizontal.bg.head.offset = 0, 0
upcomingstep.horizontal.bg.head.anim = -1
upcomingstep.horizontal.bg.head.spr = 
upcomingstep.horizontal.bg.head.scale = 1.0, 1.0
upcomingstep.horizontal.bg.head.facing = 1
upcomingstep.horizontal.bg.head.displaytime = -1
upcomingstep.horizontal.bg.palfx.color = 200
upcomingstep.horizontal.bg.palfx.invertall = 0
upcomingstep.horizontal.bg.palfx.sinadd = 0, 0, 0, 0
upcomingstep.horizontal.bg.palfx.mul = 200, 200, 200
upcomingstep.horizontal.bg.palfx.add = 0, 0, 0
upcomingstep.horizontal.glyphs.palfx.color = 200
upcomingstep.horizontal.glyphs.palfx.invertall = 0
upcomingstep.horizontal.glyphs.palfx.sinadd = 0, 0, 0, 0
upcomingstep.horizontal.glyphs.palfx.mul = 200, 200, 200
upcomingstep.horizontal.glyphs.palfx.add = 0, 0, 0


; CURRENTSTEP --------------------------------------------------------------
; CURRENTSTEP options can be specified for both vertical and horizontal layouts simultaneously.
; CURRENTSTEP VERTICAL -----------------------------------------------------
currentstep.vertical.text.offset = 0,0
currentstep.vertical.text.font = 6,0,1
currentstep.vertical.text.scale = 1.0, 1.0
currentstep.vertical.text.font.height = -1
currentstep.vertical.bg.offset = 0, 0
currentstep.vertical.bg.anim = -1
currentstep.vertical.bg.spr = 
currentstep.vertical.bg.scale = 1.0, 1.0
currentstep.vertical.bg.facing = 1
currentstep.vertical.bg.displaytime = -1
currentstep.vertical.bg.palfx.color = 256
currentstep.vertical.bg.palfx.invertall = 0
currentstep.vertical.bg.palfx.sinadd = 0, 0, 0, 0
currentstep.vertical.bg.palfx.mul = 256, 256, 256
currentstep.vertical.bg.palfx.add = 0, 0, 0
currentstep.vertical.glyphs.palfx.color = 256
currentstep.vertical.glyphs.palfx.invertall = 0
currentstep.vertical.glyphs.palfx.sinadd = 0, 0, 0, 0
currentstep.vertical.glyphs.palfx.mul = 256, 256, 256
currentstep.vertical.glyphs.palfx.add = 0, 0, 0
; CURRENTSTEP HORIZONTAL ---------------------------------------------------
currentstep.horizontal.bg.offset = 0, 0
currentstep.horizontal.bg.anim = -1
currentstep.horizontal.bg.spr = 
currentstep.horizontal.bg.scale = 1.0, 1.0
currentstep.horizontal.bg.facing = 1
currentstep.horizontal.bg.displaytime = -1
currentstep.horizontal.bg.tail.offset = 0,-14
currentstep.horizontal.bg.tail.anim = -1
currentstep.horizontal.bg.tail.spr = 402,0
currentstep.horizontal.bg.tail.scale = 1.0, 1.0
currentstep.horizontal.bg.tail.facing = 1
currentstep.horizontal.bg.tail.displaytime = -1
currentstep.horizontal.bg.head.offset = 0, 0
currentstep.horizontal.bg.head.anim = -1
currentstep.horizontal.bg.head.spr = 
currentstep.horizontal.bg.head.scale = 1.0, 1.0
currentstep.horizontal.bg.head.facing = 1
currentstep.horizontal.bg.head.displaytime = -1
currentstep.horizontal.bg.palfx.color = 200
currentstep.horizontal.bg.palfx.invertall = 0
currentstep.horizontal.bg.palfx.sinadd = 0, 0, 0, 0
currentstep.horizontal.bg.palfx.mul = 255, 255, 50
currentstep.horizontal.bg.palfx.add = 0, 0, 0
currentstep.horizontal.glyphs.palfx.color = 256
currentstep.horizontal.glyphs.palfx.invertall = 0
currentstep.horizontal.glyphs.palfx.sinadd = 0, 0, 0, 0
currentstep.horizontal.glyphs.palfx.mul = 256, 256, 256
currentstep.horizontal.glyphs.palfx.add = 0, 0, 0

; COMPLETEDSTEP -------------------------------------------------------------
; COMPLETEDSTEP options can be specified for both vertical and horizontal layouts simultaneously.
; COMPLETEDSTEP VERTICAL ----------------------------------------------------
completedstep.vertical.text.offset = 0,0
completedstep.vertical.text.font = 6,0,1, 100, 100, 100
completedstep.vertical.text.scale = 1.0, 1.0
completedstep.vertical.text.font.height = -1
completedstep.vertical.bg.offset = 0, 0
completedstep.vertical.bg.anim = -1
completedstep.vertical.bg.spr = 
completedstep.vertical.bg.scale = 1.0, 1.0
completedstep.vertical.bg.facing = 1
completedstep.vertical.bg.displaytime = -1
completedstep.vertical.bg.palfx.color = 256
completedstep.vertical.bg.palfx.invertall = 0
completedstep.vertical.bg.palfx.sinadd = 0, 0, 0, 0
completedstep.vertical.bg.palfx.mul = 256, 256, 256
completedstep.vertical.bg.palfx.add = 0, 0, 0
completedstep.vertical.glyphs.palfx.color = 0
completedstep.vertical.glyphs.palfx.invertall = 0
completedstep.vertical.glyphs.palfx.sinadd = 0, 0, 0, 0
completedstep.vertical.glyphs.palfx.mul = 256, 256, 256
