success.pos	= 640,360
success.snd	= 600,0 
success.text.text = "SUCCESS"
success.text.offset = 0,0
success.text.font = 4,0,0, 255, 100, 100
success.text.displaytime = 70
success.text.scale = 3,3
success.text.font.height = -1
success.bg.offset = 0, 0
success.bg.anim = -1
success.bg.scale = 1.0, 1.0
success.bg.spr = 
success.bg.displaytime = -1
success.front.offset = 0, 0
success.front.anim = -1
success.front.scale = 1.0, 1.0
success.front.spr = 
success.front.displaytime = -1

